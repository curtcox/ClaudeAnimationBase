{"line":"T31.C.02.1","text":"O navajo como código é um thrindle perfeito. Funcionou porque quase ninguém o falava. Cada falante a mais, sobretudo do lado inimigo, o tornava menos útil. Como língua comum é o contrário: mais falantes a tornam mais útil. Você achou o caso em que uma mesma coisa se inverte.","lufs":-18.29,"alignment":{"characters":["O"," ","n","a","v","a","j","o"," ","c","o","m","o"," ","c","ó","d","i","g","o"," ","é"," ","u","m"," ","t","h","r","i","n","d","l","e"," ","p","e","r","f","e","i","t","o","."," ","F","u","n","c","i","o","n","o","u"," ","p","o","r","q","u","e"," ","q","u","a","s","e"," ","n","i","n","g","u","é","m"," ","o"," ","f","a","l","a","v","a","."," ","C","a","d","a"," ","f","a","l","a","n","t","e"," ","a"," ","m","a","i","s",","," ","s","o","b","r","e","t","u","d","o"," ","d","o"," ","l","a","d","o"," ","i","n","i","m","i","g","o",","," ","o"," ","t","o","r","n","a","v","a"," ","m","e","n","o","s"," ","ú","t","i","l","."," ","C","o","m","o"," ","l","í","n","g","u","a"," ","c","o","m","u","m"," ","é"," ","o"," ","c","o","n","t","r","á","r","i","o",":"," ","m","a","i","s"," ","f","a","l","a","n","t","e","s"," ","a"," ","t","o","r","n","a","m"," ","m","a","i","s"," ","ú","t","i","l","."," ","V","o","c","ê"," ","a","c","h","o","u"," ","o"," ","c","a","s","o"," ","e","m"," ","q","u","e"," ","u","m","a"," ","m","e","s","m","a"," ","c","o","i","s","a"," ","s","e"," ","i","n","v","e","r","t","e","."],"character_start_times_seconds":[0,0.08,0.16,0.24,0.32,0.4,0.48,0.56,0.64,0.704,0.768,0.832,0.896,0.96,1.051,1.143,1.234,1.326,1.417,1.509,1.6,1.76,1.92,1.947,1.973,2,2.06,2.12,2.18,2.24,2.288,2.336,2.384,2.432,2.48,2.56,2.64,2.72,2.8,2.88,2.96,3.04,3.12,3.2,3.36,3.488,3.616,3.744,3.872,4,4.08,4.16,4.24,4.32,4.4,4.457,4.514,4.571,4.629,4.686,4.743,4.8,4.853,4.907,4.96,5.04,5.12,5.2,5.24,5.28,5.32,5.36,5.4,5.44,5.48,5.52,5.56,5.6,5.66,5.72,5.78,5.84,5.947,6.053,6.16,6.32,6.52,6.72,6.8,6.88,6.96,7.02,7.08,7.14,7.2,7.26,7.32,7.38,7.44,7.48,7.52,7.6,