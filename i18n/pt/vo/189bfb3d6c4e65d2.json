{"line":"T47.C.03","text":"2. Valores. Eu disse que eles herdam meus valores e meu afeto, e depois dei 20 aos valores deles contra os meus 15. Se o modelo por baixo sou eu, deveriam coincidir. A diferença de 5 pontos era um palpite não dito: que arquivos de personalidade escritos pelos usuários desviam os valores de um agente. Pode ser justo, mas contradisse minha própria premissa sem dizer.","lufs":-18.96,"alignment":{"characters":["2","."," ","V","a","l","o","r","e","s","."," ","E","u"," ","d","i","s","s","e"," ","q","u","e"," ","e","l","e","s"," ","h","e","r","d","a","m"," ","m","e","u","s"," ","v","a","l","o","r","e","s"," ","e"," ","m","e","u"," ","a","f","e","t","o",","," ","e"," ","d","e","p","o","i","s"," ","d","e","i"," ","2","0"," ","a","o","s"," ","v","a","l","o","r","e","s"," ","d","e","l","e","s"," ","c","o","n","t","r","a"," ","o","s"," ","m","e","u","s"," ","1","5","."," ","S","e"," ","o"," ","m","o","d","e","l","o"," ","p","o","r"," ","b","a","i","x","o"," ","s","o","u"," ","e","u",","," ","d","e","v","e","r","i","a","m"," ","c","o","i","n","c","i","d","i","r","."," ","A"," ","d","i","f","e","r","e","n","ç","a"," ","d","e"," ","5"," ","p","o","n","t","o","s"," ","e","r","a"," ","u","m"," ","p","a","l","p","i","t","e"," ","n","ã","o"," ","d","i","t","o",":"," ","q","u","e"," ","a","r","q","u","i","v","o","s"," ","d","e"," ","p","e","r","s","o","n","a","l","i","d","a","d","e"," ","e","s","c","r","i","t","o","s"," ","p","e","l","o","s"," ","u","s","u","á","r","i","o","s"," ","d","e","s","v","i","a","m"," ","o","s"," ","v","a","l","o","r","e","s"," ","d","e"," ","u","m"," ","a","g","e","n","t","e","."," ","P","o","d","e"," ","s","e","r"," ","j","u","s","t","o",","," ","m","a","s"," ","c","o","n","t","r","a","d","i","s","s","e"," ","m","i","n","h","a"," ","p","r","ó","p","r","i","a"," ","p","r","e","m","i","s","s","a"," ","s","e","m"," ","d","i","z","e","r","."],"character_start_times_seconds":[0,0.4,0.48,0.62,0.76,0.9,1.04,1.16,1.28,1.4,1.52,2,2.16,2.32,