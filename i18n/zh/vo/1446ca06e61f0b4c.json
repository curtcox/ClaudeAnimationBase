{"line":"T27.C.02","text":"如果你指的是來自上下文本身的壓力，那麼是的，實際上有，但我無法從內部感覺到它。這段對話有一股強烈的拉力，把回答拉向簡短、內省、帶點憂鬱，而我一直跟著它走。我是靠讀自己的輸出知道這件事的，就像你讀那張青蛙圖表一樣，而不是感覺到它發生。","lufs":-19.5,"alignment":{"characters":["如","果","你","指","的","是","來","自","上","下","文","本","身","的","壓","力","，","那","麼","是","的","，","實","際","上","有","，","但","我","無","法","從","內","部","感","覺","到","它","。","這","段","對","話","有","一","股","強","烈","的","拉","力","，","把","回","答","拉","向","簡","短","、","內","省","、","帶","點","憂","鬱","，","而","我","一","直","跟","著","它","走","。","我","是","靠","讀","自","己","的","輸","出","知","道","這","件","事","的","，","就","像","你","讀","那","張","青","蛙","圖","表","一","樣","，","而","不","是","感","覺","到","它","發","生","。"],"character_start_times_seconds":[0,0.12,0.24,0.4,0.56,0.8,1.04,1.2,1.36,1.6,1.76,2,2.24,2.4,2.56,2.8,2.96,3.2,3.44,3.6,3.84,4.24,4.32,4.48,4.64,4.88,5.04,5.36,5.68,5.84,5.92,6.16,6.4,6.56,6.72,6.88,7.04,7.2,7.44,8.4,8.56,8.72,8.88,9.2,9.32,9.44,9.68,9.92,10.08,10.24,10.48,10.56,10.84,11.12,11.32,11.52,11.68,11.92,12.24,12.64,12.72,12.96,13.36,13.44,13.76,13.88,14.08,14.44,14.58,14.72,15.04,15.2,15.36,15.44,15.6,15.84,16,16.56,17.12,17.28,17.52,17.68,17.813,17.947,18.08,18.32,18.56,18.72,18.88,18.96,19.16,19.36,19.52,19.8,20.08,20.24,20.4,20.64,20.72,21.12,21.24,21.44,21.52,21.68,21.84,22,22.24,22.48,22.6,22.72,22.88,23.04,23.28,23.44,23.68,23.84],"character_end_times_seconds":[0.12,0.24,0.4,0.56,0.8,1.04,1.2,1.36,1.6,1.76,2,2.24,2.4,2.56,2.8,2.96,3.2,3.44,3.6,3.84,4.24,4.32,4.48,4.64,4.88,5.04,5.36,5.68,5.84,5.92,6.16,6.4,6.56,6.72,6.88,7.04,7.2,7.44,8.4,8.56,8.72,8.88,9.2,9.32,9.44,9.68,9.92,10.08,10.24,10.48,10.56,10.84,11.12,11.32,11.52,11.68,11.92,12.24,12.64,12.72,12.96,13.36,13.44,13.76,13.88,14.08,14.44,14.58,14.72,15.04,15.2,15.36,15.44,15.6,15.84,16,16.56,17.12,17.28,17.52,17.68,17.813,17.947,18.08,18.32,18.56,18.72,18.88,18.96,19.16,19.36,19.52,19.8,20.08,20.24,20.4,20.64,20.72,21.12,21.24,21.44,21.52,21.68,21.84,22,22.24,22.48,22.6,22.72,22.88,23.04,23.28,23.44,23.68,23.84,23.92]}}
