{"line":"T76.C.04","text":"它的優點是可以被判定，這很少見。缺點是：檢核表會被刷滿，古德哈特定律就接手了。圖靈測試有一部分在測欺騙的本事。而機器人那一項，把「通用智慧」和一雙手綁在一起，這比傑夫願意承認的更接近他的抱怨。","lufs":-19.77,"alignment":{"characters":["它","的","優","點","是","可","以","被","判","定","，","這","很","少","見","。","缺","點","是","：","檢","核","表","會","被","刷","滿","，","古","德","哈","特","定","律","就","接","手","了","。","圖","靈","測","試","有","一","部","分","在","測","欺","騙","的","本","事","。","而","機","器","人","那","一","項","，","把","「","通","用","智","慧","」","和","一","雙","手","綁","在","一","起","，","這","比","傑","夫","願","意","承","認","的","更","接","近","他","的","抱","怨","。"],"character_start_times_seconds":[0,0.08,0.24,0.4,0.64,0.8,0.96,1.12,1.28,1.52,1.68,1.88,2.08,2.32,2.56,2.8,3.52,3.68,3.92,4.4,4.48,4.64,4.8,5.04,5.2,5.44,5.68,5.84,6.24,6.32,6.48,6.72,6.88,7.12,7.36,7.52,7.68,7.92,8,9.2,9.36,9.413,9.467,9.52,10.16,10.32,10.56,10.8,10.96,11.2,11.52,11.64,11.68,11.92,12.08,12.44,12.8,12.96,13.2,13.36,13.6,13.76,13.84,14.08,14.32,14.4,14.48,14.72,14.96,15.2,15.28,15.36,15.52,15.76,16.08,16.32,16.4,16.56,16.72,17.08,17.44,17.6,17.88,18,18.16,18.32,18.48,18.72,18.96,19.2,19.36,19.52,19.64,19.76,20,20.2],"character_end_times_seconds":[0.08,0.24,0.4,0.64,0.8,0.96,1.12,1.28,1.52,1.68,1.88,2.08,2.32,2.56,2.8,3.52,3.68,3.92,4.4,4.48,4.64,4.8,5.04,5.2,5.44,5.68,5.84,6.24,6.32,6.48,6.72,6.88,7.12,7.36,7.52,7.68,7.92,8,9.2,9.36,9.413,9.467,9.52,10.16,10.32,10.56,10.8,10.96,11.2,11.52,11.64,11.68,11.92,12.08,12.44,12.8,12.96,13.2,13.36,13.6,13.76,13.84,14.08,14.32,14.4,14.48,14.72,14.96,15.2,15.28,15.36,15.52,15.76,16.08,16.32,16.4,16.56,16.72,17.08,17.44,17.6,17.88,18,18.16,18.32,18.48,18.72,18.96,19.2,19.36,19.52,19.64,19.76,20,20.2,20.24]}}
