{"line":"T60.C.02.1","text":"1. 混沌。在混沌系統裡，你能預測多遠，只隨著測量精度的對數增長：t大約等於λ分之一，乘以大寫Δ除以小寫δ的自然對數。測量好上一百萬倍，也只多換來寥寥幾個李亞普諾夫時間。天氣、市場和人，對任何智慧來說都仍有一部分是不透明的。","lufs":-19.38,"alignment":{"characters":["1","."," ","混","沌","。","在","混","沌","系","統","裡","，","你","能","預","測","多","遠","，","只","隨","著","測","量","精","度","的","對","數","增","長","：","t","大","約","等","於","λ","分","之","一","，","乘","以","大","寫","Δ","除","以","小","寫","δ","的","自","然","對","數","。","測","量","好","上","一","百","萬","倍","，","也","只","多","換","來","寥","寥","幾","個","李","亞","普","諾","夫","時","間","。","天","氣","、","市","場","和","人","，","對","任","何","智","慧","來","說","都","仍","有","一","部","分","是","不","透","明","的","。"],"character_start_times_seconds":[0,0.24,0.64,0.96,1.12,1.6,1.76,1.92,2.08,2.52,2.62,2.72,3.04,3.12,3.2,3.36,3.6,3.76,4.08,4.24,4.56,4.88,5.04,5.2,5.44,5.68,5.84,6.08,6.24,6.48,6.72,7.12,7.2,7.76,8.08,8.24,8.48,8.64,9.04,9.52,9.76,9.96,10.16,10.64,10.8,10.96,11.2,11.44,12,12.24,12.48,12.72,13.04,13.28,13.44,13.6,13.76,14,14.24,14.96,15.12,15.36,15.52,15.76,15.92,16.16,16.4,16.64,16.92,17.2,17.36,17.52,18,18.12,18.4,18.56,18.72,19.04,19.2,19.36,19.52,19.76,19.92,20.12,20.32,21.04,21.28,21.6,21.84,22.12,22.4,22.56,23.12,23.2,23.36,23.56,23.76,23.92,24.08,24.4,24.72,24.96,25.2,25.36,25.52,25.76,26,26.16,26.32,26.48,26.72,26.88],"character_end_times_seconds":[0.24,0.64,0.96,1.12,1.6,1.76,1.92,2.08,2.52,2.62,2.72,3.04,3.12,3.2,3.36,3.6,3.76,4.08,4.24,4.56,4.88,5.04,5.2,5.44,5.68,5.84,6.08,6.24,6.48,6.72,7.12,7.2,7.76,8.08,8.24,8.48,8.64,9.04,9.52,9.76,9.96,10.16,10.64,10.8,10.96,11.2,11.44,12,12.24,12.48,12.72,13.04,13.28,13.44,13.6,13.76,14,14.24,14.96,15.12,15.36,15.52,15.76,15.92,16.16,16.4,16.64,16.92,17.2,17.36,17.52,18,18.12,18.4,18.56,18.72,19.04,19.2,19.36,19.52,19.76,19.92,20.12,20.32,21.04,21.28,21.6,21.84,22.12,22.4,22.56,23.12,23.2,23.36,23.56,23.76,23.92,24.08,24.4,24.72,24.96,25.2,25.36,25.52,25.76,26,26.16,26.32,26.48,26.72,26.88,27.04]}}
