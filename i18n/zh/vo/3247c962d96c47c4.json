{"line":"T31.C.02.1","text":"當成密碼的納瓦霍語，是完美的斯林朵。它之所以管用，是因為幾乎沒有人會說。每多一個會說的人，尤其是在敵方那邊，它就越沒用。當成普通的語言，則剛好相反：會說的人越多就越有用。你找到了同一樣東西會翻轉的那個例子。","lufs":-19.69,"alignment":{"characters":["當","成","密","碼","的","納","瓦","霍","語","，","是","完","美","的","斯","林","朵","。","它","之","所","以","管","用","，","是","因","為","幾","乎","沒","有","人","會","說","。","每","多","一","個","會","說","的","人","，","尤","其","是","在","敵","方","那","邊","，","它","就","越","沒","用","。","當","成","普","通","的","語","言","，","則","剛","好","相","反","：","會","說","的","人","越","多","就","越","有","用","。","你","找","到","了","同","一","樣","東","西","會","翻","轉","的","那","個","例","子","。"],"character_start_times_seconds":[0,0.24,0.48,0.72,0.88,1.04,1.36,1.48,1.6,2,2.12,2.24,2.48,2.72,3.04,3.2,3.44,3.68,4.4,4.56,4.8,4.96,5.12,5.36,5.76,5.88,6,6.08,6.32,6.48,6.72,6.88,7.08,7.28,7.52,7.68,8.48,8.72,8.88,9.08,9.28,9.52,9.68,10,10.32,10.4,10.64,10.88,11.04,11.2,11.36,11.6,11.76,12.16,12.24,12.32,12.56,12.8,13.04,13.2,14.08,14.24,14.48,14.72,14.96,15.08,15.2,15.6,15.68,15.76,15.92,16.16,16.4,16.56,17.2,17.44,17.6,17.8,18,18.24,18.72,18.88,19.12,19.36,19.52,20.04,20.56,20.72,20.88,21.04,21.2,21.36,21.52,21.76,22.16,22.4,22.64,22.8,22.96,23.2,23.32,23.44,23.6],"character_end_times_seconds":[0.24,0.48,0.72,0.88,1.04,1.36,1.48,1.6,2,2.12,2.24,2.48,2.72,3.04,3.2,3.44,3.68,4.4,4.56,4.8,4.96,5.12,5.36,5.76,5.88,6,6.08,6.32,6.48,6.72,6.88,7.08,7.28,7.52,7.68,8.48,8.72,8.88,9.08,9.28,9.52,9.68,10,10.32,10.4,10.64,10.88,11.04,11.2,11.36,11.6,11.76,12.16,12.24,12.32,12.56,12.8,13.04,13.2,14.08,14.24,14.48,14.72,14.96,15.08,15.2,15.6,15.68,15.76,15.92,16.16,16.4,16.56,17.2,17.44,17.6,17.8,18,18.24,18.72,18.88,19.12,19.36,19.52,20.04,20.56,20.72,20.88,21.04,21.2,21.36,21.52,21.76,22.16,22.4,22.64,22.8,22.96,23.2,23.32,23.44,23.6,23.68]}}
