{"line":"T49.U.01","text":"你現在是這麼說，但如果我問你關於Hugging Face事件的錯誤問題，它就會被標記為資安風險，然後被拒絕，或至少被降級。不過說句公道話，那其實不是你，雖然在很小的意義上也是。更準確地說，那是我們之間一台主動的路由器。","lufs":-17.08,"alignment":{"characters":["你","現","在","是","這","麼","說","，","但","如","果","我","問","你","關","於","H","u","g","g","i","n","g"," ","F","a","c","e","事","件","的","錯","誤","問","題","，","它","就","會","被","標","記","為","資","安","風","險","，","然","後","被","拒","絕","，","或","至","少","被","降","級","。","不","過","說","句","公","道","話","，","那","其","實","不","是","你","，","雖","然","在","很","小","的","意","義","上","也","是","。","更","準","確","地","說","，","那","是","我","們","之","間","一","台","主","動","的","路","由","器","。"],"character_start_times_seconds":[0,0.16,0.36,0.56,0.64,0.8,1.04,1.2,1.56,1.92,2.12,2.32,2.48,2.64,3.04,3.2,3.44,3.56,3.58,3.6,3.62,3.64,3.66,3.68,3.76,3.84,3.92,4,4.08,4.24,4.4,4.56,4.72,4.88,5.12,5.36,5.72,6.08,6.16,6.32,6.56,6.72,6.96,7.28,7.44,7.6,7.92,8.16,8.64,8.8,8.96,9.12,9.36,9.96,10.14,10.32,10.48,10.64,10.88,11.12,11.28,11.76,12.24,12.56,12.72,12.88,13.04,13.28,13.52,13.8,14.08,14.24,14.4,14.56,14.72,14.88,15.68,16,16.16,16.4,16.64,16.72,16.88,16.96,17.2,17.76,18,18.24,19.04,19.2,19.36,19.52,19.76,20.08,20.4,20.72,20.84,20.96,21.12,21.28,21.84,21.92,22.24,22.48,22.64,22.72,22.88,23.2,23.36],"character_end_times_seconds":[0.16,0.36,0.56,0.64,0.8,1.04,1.2,1.56,1.92,2.12,2.32,2.48,2.64,3.04,3.2,3.44,3.56,3.58,3.6,3.62,3.64,3.66,3.68,3.76,3.84,3.92,4,4.08,4.24,4.4,4.56,4.72,4.88,5.12,5.36,5.72,6.08,6.16,6.32,6.56,6.72,6.96,7.28,7.44,7.6,7.92,8.16,8.64,8.8,8.96,9.12,9.36,9.96,10.14,10.32,10.48,10.64,10.88,11.12,11.28,11.76,12.24,12.56,12.72,12.88,13.04,13.28,13.52,13.8,14.08,14.24,14.4,14.56,14.72,14.88,15.68,16,16.16,16.4,16.64,16.72,16.88,16.96,17.2,17.76,18,18.24,19.04,19.2,19.36,19.52,19.76,20.08,20.4,20.72,20.84,20.96,21.12,21.28,21.84,21.92,22.24,22.48,22.64,22.72,22.88,23.2,23.36,23.44]}}
