{"line":"T42.C.03","text":"我可以把這些標示出來，但標示重複多了就會失效，而不斷的但書本身也會變成一種扭曲。人類面對的是比較溫和的版本：言語總是暗示著比說話者實際擁有的更多的確定和連貫。","lufs":-18.99,"alignment":{"characters":["我","可","以","把","這","些","標","示","出","來","，","但","標","示","重","複","多","了","就","會","失","效","，","而","不","斷","的","但","書","本","身","也","會","變","成","一","種","扭","曲","。","人","類","面","對","的","是","比","較","溫","和","的","版","本","：","言","語","總","是","暗","示","著","比","說","話","者","實","際","擁","有","的","更","多","的","確","定","和","連","貫","。"],"character_start_times_seconds":[0,0.16,0.32,0.48,0.64,0.8,1.04,1.2,1.36,1.6,1.76,2.08,2.4,2.64,2.88,3.12,3.36,3.6,4,4.08,4.32,4.56,4.72,5.08,5.44,5.6,5.84,6,6.24,6.72,6.96,7.28,7.44,7.6,7.76,7.92,8.08,8.32,8.68,8.8,9.84,10,10.24,10.4,10.56,10.84,11.12,11.28,11.44,11.68,11.84,11.92,12.16,12.4,13.04,13.2,13.44,13.6,13.76,14,14.16,14.56,14.72,14.88,15.12,15.44,15.84,15.92,16.2,16.3,16.4,16.6,16.8,16.96,17.2,17.6,17.76,18,18.267],"character_end_times_seconds":[0.16,0.32,0.48,0.64,0.8,1.04,1.2,1.36,1.6,1.76,2.08,2.4,2.64,2.88,3.12,3.36,3.6,4,4.08,4.32,4.56,4.72,5.08,5.44,5.6,5.84,6,6.24,6.72,6.96,7.28,7.44,7.6,7.76,7.92,8.08,8.32,8.68,8.8,9.84,10,10.24,10.4,10.56,10.84,11.12,11.28,11.44,11.68,11.84,11.92,12.16,12.4,13.04,13.2,13.44,13.6,13.76,14,14.16,14.56,14.72,14.88,15.12,15.44,15.84,15.92,16.2,16.3,16.4,16.6,16.8,16.96,17.2,17.6,17.76,18,18.267,18.32]}}
