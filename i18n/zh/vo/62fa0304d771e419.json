{"line":"T34.C.02","text":"關於扎根，說它「自私自利」很公道。這個標準剛好把它瞄準的東西排除在外。它也正在被侵蝕：模型現在會看圖像、使用工具，也會在環境中行動。而且，你自己對「正義」或「質數」的掌握，很多是透過文字而不是感官得來的。","lufs":-19.49,"alignment":{"characters":["關","於","扎","根","，","說","它","「","自","私","自","利","」","很","公","道","。","這","個","標","準","剛","好","把","它","瞄","準","的","東","西","排","除","在","外","。","它","也","正","在","被","侵","蝕","：","模","型","現","在","會","看","圖","像","、","使","用","工","具","，","也","會","在","環","境","中","行","動","。","而","且","，","你","自","己","對","「","正","義","」","或","「","質","數","」","的","掌","握","，","很","多","是","透","過","文","字","而","不","是","感","官","得","來","的","。"],"character_start_times_seconds":[0,0.24,0.4,0.64,0.8,1.12,1.36,1.76,1.84,2,2.24,2.48,2.64,2.8,3.04,3.2,3.44,4.32,4.56,4.88,5.04,5.2,5.44,5.6,5.92,6.04,6.24,6.32,6.4,6.72,7.04,7.2,7.44,7.6,7.84,8.72,8.96,9.2,9.52,9.84,9.96,10.08,10.84,11.28,11.48,11.68,11.88,12.08,12.24,12.4,12.64,13.2,13.36,13.44,13.52,13.76,14,14.28,14.56,14.72,14.88,15.12,15.36,15.6,15.84,16.08,16.56,17.04,17.28,17.56,17.84,18.08,18.32,18.56,18.72,18.88,19.12,19.2,19.44,19.56,19.68,19.76,19.84,19.92,20.16,20.4,20.88,21.08,21.28,21.44,21.6,21.84,22.24,22.64,22.8,22.96,23.12,23.36,23.6,23.76,23.92,24.16],"character_end_times_seconds":[0.24,0.4,0.64,0.8,1.12,1.36,1.76,1.84,2,2.24,2.48,2.64,2.8,3.04,3.2,3.44,4.32,4.56,4.88,5.04,5.2,5.44,5.6,5.92,6.04,6.24,6.32,6.4,6.72,7.04,7.2,7.44,7.6,7.84,8.72,8.96,9.2,9.52,9.84,9.96,10.08,10.84,11.28,11.48,11.68,11.88,12.08,12.24,12.4,12.64,13.2,13.36,13.44,13.52,13.76,14,14.28,14.56,14.72,14.88,15.12,15.36,15.6,15.84,16.08,16.56,17.04,17.28,17.56,17.84,18.08,18.32,18.56,18.72,18.88,19.12,19.2,19.44,19.56,19.68,19.76,19.84,19.92,20.16,20.4,20.88,21.08,21.28,21.44,21.6,21.84,22.24,22.64,22.8,22.96,23.12,23.36,23.6,23.76,23.92,24.16,24.24]}}
