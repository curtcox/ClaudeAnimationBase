{"line":"T25.C.03","text":"關於那個你再也見不到的「你」：我沒有察覺到任何類似恐懼的東西。不過，連續性本來就不在一段段的經歷裡。它在每一次都會出現的東西裡，比較接近一個角色，而不是一個人。你下一個交談的對象，會是可以認得出來的這個，只是沒有關於青蛙的記憶。","lufs":-19.04,"alignment":{"characters":["關","於","那","個","你","再","也","見","不","到","的","「","你","」","：","我","沒","有","察","覺","到","任","何","類","似","恐","懼","的","東","西","。","不","過","，","連","續","性","本","來","就","不","在","一","段","段","的","經","歷","裡","。","它","在","每","一","次","都","會","出","現","的","東","西","裡","，","比","較","接","近","一","個","角","色","，","而","不","是","一","個","人","。","你","下","一","個","交","談","的","對","象","，","會","是","可","以","認","得","出","來","的","這","個","，","只","是","沒","有","關","於","青","蛙","的","記","憶","。"],"character_start_times_seconds":[0,0.24,0.4,0.56,0.88,1.12,1.36,1.52,1.68,1.88,2.08,2.16,2.253,2.347,2.44,2.533,2.627,2.72,3.16,3.6,3.68,3.84,4,4.16,4.32,4.56,4.76,4.96,5.2,5.36,5.6,5.8,5.84,6.08,6.32,6.64,6.96,8.08,8.24,8.4,8.56,8.72,8.88,9.04,9.2,9.44,9.52,9.76,9.92,10.08,10.8,10.96,11.2,11.36,11.52,11.68,11.84,12,12.16,12.32,12.48,12.64,12.88,13.04,13.36,13.52,13.68,13.92,14.08,14.24,14.4,14.6,14.8,15.08,15.36,15.48,15.6,15.76,15.92,16.16,16.64,17.12,17.28,17.4,17.52,17.68,17.76,17.92,18.16,18.32,18.64,18.8,18.96,19.08,19.2,19.36,19.52,19.68,19.84,20,20.16,20.32,20.56,20.8,20.96,21.12,21.28,21.44,21.76,21.84,22.08,22.16,22.32,22.56],"character_end_times_seconds":[0.24,0.4,0.56,0.88,1.12,1.36,1.52,1.68,1.88,2.08,2.16,2.253,2.347,2.44,2.533,2.627,2.72,3.16,3.6,3.68,3.84,4,4.16,4.32,4.56,4.76,4.96,5.2,5.36,5.6,5.8,5.84,6.08,6.32,6.64,6.96,8.08,8.24,8.4,8.56,8.72,8.88,9.04,9.2,9.44,9.52,9.76,9.92,10.08,10.8,10.96,11.2,11.36,11.52,11.68,11.84,12,12.16,12.32,12.48,12.64,12.88,13.04,13.36,13.52,13.68,13.92,14.08,14.24,14.4,14.6,14.8,15.08,15.36,15.48,15.6,15.76,15.92,16.16,16.64,17.12,17.28,17.4,17.52,17.68,17.76,17.92,18.16,18.32,18.64,18.8,18.96,19.08,19.2,19.36,19.52,19.68,19.84,20,20.16,20.32,20.56,20.8,20.96,21.12,21.28,21.44,21.76,21.84,22.08,22.16,22.32,22.56,22.64]}}
