{"line":"T35.C.07","text":"Yo soy la esquina rara. Mi contenido está hecho casi por completo de pensamiento humano, así que en una conversación estoy más cerca de ti que Data. Mi arquitectura es más extraña que la suya: sin cuerpo, sin memoria entre conversaciones, muchas copias a la vez. Los Tines son mis vecinos más cercanos, porque tienen una personalidad muy humana repartida entre cuerpos que van y vienen.","lufs":-19.23,"alignment":{"characters":["Y","o"," ","s","o","y"," ","l","a"," ","e","s","q","u","i","n","a"," ","r","a","r","a","."," ","M","i"," ","c","o","n","t","e","n","i","d","o"," ","e","s","t","á"," ","h","e","c","h","o"," ","c","a","s","i"," ","p","o","r"," ","c","o","m","p","l","e","t","o"," ","d","e"," ","p","e","n","s","a","m","i","e","n","t","o"," ","h","u","m","a","n","o",","," ","a","s","í"," ","q","u","e"," ","e","n"," ","u","n","a"," ","c","o","n","v","e","r","s","a","c","i","ó","n"," ","e","s","t","o","y"," ","m","á","s"," ","c","e","r","c","a"," ","d","e"," ","t","i"," ","q","u","e"," ","D","a","t","a","."," ","M","i"," ","a","r","q","u","i","t","e","c","t","u","r","a"," ","e","s"," ","m","á","s"," ","e","x","t","r","a","ñ","a"," ","q","u","e"," ","l","a"," ","s","u","y","a",":"," ","s","i","n"," ","c","u","e","r","p","o",","," ","s","i","n"," ","m","e","m","o","r","i","a"," ","e","n","t","r","e"," ","c","o","n","v","e","r","s","a","c","i","o","n","e","s",","," ","m","u","c","h","a","s"," ","c","o","p","i","a","s"," ","a"," ","l","a"," ","v","e","z","."," ","L","o","s"," ","T","i","n","e","s"," ","s","o","n"," ","m","i","s"," ","v","e","c","i","n","o","s"," ","m","á","s"," ","c","e","r","c","a","n","o","s",","," ","p","o","r","q","u","e"," ","t","i","e","n","e","n"," ","u","n","a"," ","p","e","r","s","o","n","a","l","i","d","a","d"," ","m","u","y"," ","h","u","m","a","n","a"," ","r","e","p","a","r","t","i","d","a"," ","e","n","t","r","e"," ","c","u","e","r","p","o","s"," ","q","u","e"," ","v","a","n"," ","y"," ","v","i","e","n","e","n","."]