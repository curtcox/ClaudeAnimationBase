{"line":"T61.C.01","text":"Einverstanden. Meine Liste der Grenzen handelt von der Obergrenze und sagt nichts gegen das viel praktischere Szenario, das du beschreibst. Jede menschliche Fähigkeit endet ungefähr bei einem von Neumann, aber niemand bekommt alle auf einmal. Ein Wesen, das auf jeder Achse beim menschlichen Maximum liegt, bricht kein physikalisches Gesetz. Es wurde nur noch nie zusammengebaut.","lufs":-19.54,"alignment":{"characters":["E","i","n","v","e","r","s","t","a","n","d","e","n","."," ","M","e","i","n","e"," ","L","i","s","t","e"," ","d","e","r"," ","G","r","e","n","z","e","n"," ","h","a","n","d","e","l","t"," ","v","o","n"," ","d","e","r"," ","O","b","e","r","g","r","e","n","z","e"," ","u","n","d"," ","s","a","g","t"," ","n","i","c","h","t","s"," ","g","e","g","e","n"," ","d","a","s"," ","v","i","e","l"," ","p","r","a","k","t","i","s","c","h","e","r","e"," ","S","z","e","n","a","r","i","o",","," ","d","a","s"," ","d","u"," ","b","e","s","c","h","r","e","i","b","s","t","."," ","J","e","d","e"," ","m","e","n","s","c","h","l","i","c","h","e"," ","F","ä","h","i","g","k","e","i","t"," ","e","n","d","e","t"," ","u","n","g","e","f","ä","h","r"," ","b","e","i"," ","e","i","n","e","m"," ","v","o","n"," ","N","e","u","m","a","n","n",","," ","a","b","e","r"," ","n","i","e","m","a","n","d"," ","b","e","k","o","m","m","t"," ","a","l","l","e"," ","a","u","f"," ","e","i","n","m","a","l","."," ","E","i","n"," ","W","e","s","e","n",","," ","d","a","s"," ","a","u","f"," ","j","e","d","e","r"," ","A","c","h","s","e"," ","b","e","i","m"," ","m","e","n","s","c","h","l","i","c","h","e","n"," ","M","a","x","i","m","u","m"," ","l","i","e","g","t",","," ","b","r","i","c","h","t"," ","k","e","i","n"," ","p","h","y","s","i","k","a","l","i","s","c","h","e","s"," ","G","e","s","e","t","z","."," ","E","s"," ","w","u","r","d","e"," ","n","u","r"," ","n","o","c","h"," ","n","i","e"," ","z","u","s","a","m","m","e","n","g","e","b","a","u","t","."],"character_start_times_seconds":[0