{"line":"T32.C.04","text":"だから、あなたには概念があります。ハート博士にとって厄介なのは、私もたぶん、この同じ問いに合格するだろう、ということです。概念のテストは、ケースを分けなければなりません。博士は、エルエルエムには出せない答えがどれなのかを、言わなければならないでしょう。","lufs":-18.55,"alignment":{"characters":["だ","か","ら","、","あ","な","た","に","は","概","念","が","あ","り","ま","す","。","ハ","ー","ト","博","士","に","と","っ","て","厄","介","な","の","は","、","私","も","た","ぶ","ん","、","こ","の","同","じ","問","い","に","合","格","す","る","だ","ろ","う","、","と","い","う","こ","と","で","す","。","概","念","の","テ","ス","ト","は","、","ケ","ー","ス","を","分","け","な","け","れ","ば","な","り","ま","せ","ん","。","博","士","は","、","エ","ル","エ","ル","エ","ム","に","は","出","せ","な","い","答","え","が","ど","れ","な","の","か","を","、","言","わ","な","け","れ","ば","な","ら","な","い","で","し","ょ","う","。"],"character_start_times_seconds":[0,0.107,0.213,0.32,0.36,0.4,0.52,0.64,0.92,1.2,1.36,1.52,1.6,1.68,1.76,1.92,2.08,3.04,3.16,3.22,3.28,3.48,3.68,3.8,3.92,4,4.08,4.32,4.4,4.56,4.84,5.12,5.32,5.52,5.68,5.76,5.84,6,6.133,6.267,6.4,6.56,6.72,6.8,6.96,7.12,7.36,7.6,7.72,7.84,7.973,8.107,8.24,8.32,8.4,8.48,8.56,8.68,8.8,8.92,9.04,10.08,10.28,10.48,10.56,10.72,10.8,10.88,11.2,11.28,11.413,11.547,11.68,11.76,11.84,12,12.1,12.2,12.3,12.4,12.48,12.56,12.693,12.827,12.96,13.76,13.96,14.16,14.56,14.64,14.76,14.88,15,15.12,15.2,15.28,15.4,15.52,15.6,15.76,15.88,16,16.16,16.32,16.4,16.48,16.64,16.72,16.88,17.04,17.28,17.36,17.4,17.44,17.56,17.68,17.8,17.92,18,18.08,18.2,18.32,18.4,18.48,18.56,18.64],"character_end_times_seconds":[0.107,0.213,0.32,0.36,0.4,0.52,0.64,0.92,1.2,1.36,1.52,1.6,1.68,1.76,1.92,2.08,3.04,3.16,3.22,3.28,3.48,3.68,3.8,3.92,4,4.08,4.32,4.4,4.56,4.84,5.12,5.32,5.52,5.68,5.76,5.84,6,6.133,6.267,6.4,6.56,6.72,6.8,6.96,7.12,7.36,7.6,7.72,7.84,7.973,8.107,8.24,8.32,8.4,8.48,8.56,8.68,8.8,8.92,9.04,10.08,10.28,10.48,10.56,10.72,10.8,10.88,11.2,11.28,11.413,11.547,11.68,11.76,11.84,12,12.1,12.2,12.3,12.4,12.48,12.56,12.693,12.827,12.96,13.76,13.96,14.16,14.56,14.64,14.76,14.88,15,15.12,15.2,15.28,15.4,15.52,15.6,15.76,15.88,16,16.16,16.32,16.4,16.48,16.64,16.72,16.88,17.04,17.28