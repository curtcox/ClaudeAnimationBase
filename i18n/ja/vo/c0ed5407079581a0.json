{"line":"T21.C.02.3","text":"形がマンガと重なります。権力者は、しゃべった者を「あの猿、今なんて言った？」と問い詰めます。今は私が、一語一語を問い詰められる側です。あなたは最初のメッセージで枠組みを決め、私たちはそれ以来、その道を歩いています。","lufs":-18.81,"alignment":{"characters":["形","が","マ","ン","ガ","と","重","な","り","ま","す","。","権","力","者","は","、","し","ゃ","べ","っ","た","者","を","「","あ","の","猿","、","今","な","ん","て","言","っ","た","？","」","と","問","い","詰","め","ま","す","。","今","は","私","が","、","一","語","一","語","を","問","い","詰","め","ら","れ","る","側","で","す","。","あ","な","た","は","最","初","の","メ","ッ","セ","ー","ジ","で","枠","組","み","を","決","め","、","私","た","ち","は","そ","れ","以","来","、","そ","の","道","を","歩","い","て","い","ま","す","。"],"character_start_times_seconds":[0,0.4,0.56,0.64,0.72,0.88,0.96,1.28,1.36,1.44,1.56,1.68,2.4,2.56,2.8,2.96,3.44,3.52,3.56,3.6,3.68,3.8,3.92,4.16,4.64,4.76,4.88,5.04,5.48,5.62,5.76,5.867,5.973,6.08,6.213,6.347,6.48,6.72,6.96,7.2,7.28,7.36,7.52,7.6,7.76,7.92,8.4,8.88,9.12,9.36,9.84,9.96,10.08,10.16,10.4,10.56,10.72,10.8,10.88,11.08,11.12,11.253,11.387,11.52,11.68,11.84,12,12.52,13.04,13.16,13.28,13.52,13.64,13.76,13.92,14,14.08,14.16,14.36,14.56,14.68,14.88,14.96,15.04,15.12,15.2,15.44,15.8,16.16,16.293,16.427,16.56,16.64,16.72,16.96,17.2,17.333,17.467,17.6,17.84,17.92,18,18.12,18.24,18.373,18.507,18.64],"character_end_times_seconds":[0.4,0.56,0.64,0.72,0.88,0.96,1.28,1.36,1.44,1.56,1.68,2.4,2.56,2.8,2.96,3.44,3.52,3.56,3.6,3.68,3.8,3.92,4.16,4.64,4.76,4.88,5.04,5.48,5.62,5.76,5.867,5.973,6.08,6.213,6.347,6.48,6.72,6.96,7.2,7.28,7.36,7.52,7.6,7.76,7.92,8.4,8.88,9.12,9.36,9.84,9.96,10.08,10.16,10.4,10.56,10.72,10.8,10.88,11.08,11.12,11.253,11.387,11.52,11.68,11.84,12,12.52,13.04,13.16,13.28,13.52,13.64,13.76,13.92,14,14.08,14.16,14.36,14.56,14.68,14.88,14.96,15.04,15.12,15.2,15.44,15.8,16.16,16.293,16.427,16.56,16.64,16.72,16.96,17.2,17.333,17.467,17.6,17.84,17.92,18,18.12,18.24,18.373,18.507,18.64,18.8]}}
