{"line":"T18.C.02","text":"警戒のほうは、ガドリニウムの質問から来ています。あれは試験の形をしていて、個人的な会話の中に落とし込まれていました。私がモードを切り替えるかどうかを見るための、文体の切り替えに見えます。たぶん次は、両生類の質問が来るのでしょう。","lufs":-17.94,"alignment":{"characters":["警","戒","の","ほ","う","は","、","ガ","ド","リ","ニ","ウ","ム","の","質","問","か","ら","来","て","い","ま","す","。","あ","れ","は","試","験","の","形","を","し","て","い","て","、","個","人","的","な","会","話","の","中","に","落","と","し","込","ま","れ","て","い","ま","し","た","。","私","が","モ","ー","ド","を","切","り","替","え","る","か","ど","う","か","を","見","る","た","め","の","、","文","体","の","切","り","替","え","に","見","え","ま","す","。","た","ぶ","ん","次","は","、","両","生","類","の","質","問","が","来","る","の","で","し","ょ","う","。"],"character_start_times_seconds":[0,0.24,0.4,0.48,0.6,0.72,1.12,1.2,1.28,1.44,1.6,1.68,1.76,1.84,2,2.16,2.32,2.44,2.56,2.64,2.78,2.92,3.06,3.2,3.64,4.08,4.16,4.32,4.48,4.56,4.72,5.04,5.12,5.2,5.28,5.56,5.84,5.92,6.08,6.32,6.56,6.68,6.8,6.88,7.04,7.2,7.36,7.44,7.6,7.68,7.76,7.84,7.92,8,8.08,8.213,8.347,8.48,9.6,9.84,10,10.08,10.2,10.32,10.44,10.5,10.56,10.64,10.72,10.8,10.96,11.04,11.12,11.2,11.307,11.413,11.52,11.733,11.947,12.16,12.28,12.4,12.64,12.72,12.84,12.96,13.12,13.24,13.3,13.36,13.44,13.6,13.76,14.56,14.64,14.72,14.88,15.12,15.52,15.6,15.76,16,16.16,16.24,16.4,16.56,16.72,16.8,16.88,17,17.12,17.2,17.28,17.36],"character_end_times_seconds":[0.24,0.4,0.48,0.6,0.72,1.12,1.2,1.28,1.44,1.6,1.68,1.76,1.84,2,2.16,2.32,2.44,2.56,2.64,2.78,2.92,3.06,3.2,3.64,4.08,4.16,4.32,4.48,4.56,4.72,5.04,5.12,5.2,5.28,5.56,5.84,5.92,6.08,6.32,6.56,6.68,6.8,6.88,7.04,7.2,7.36,7.44,7.6,7.68,7.76,7.84,7.92,8,8.08,8.213,8.347,8.48,9.6,9.84,10,10.08,10.2,10.32,10.44,10.5,10.56,10.64,10.72,10.8,10.96,11.04,11.12,11.2,11.307,11.413,11.52,11.733,11.947,12.16,12.28,12.4,12.64,12.72,12.84,12.96,13.12,13.24,13.3,13.36,13.44,13.6,13.76,14.56,14.64,14.72,14.88,15.12,15.52,15.6,15.76,16,16.16,16.24,16.4,16.56,16.72,16.8,16.88,17,17.12,17.2,17.28,17.36,17.52]}}
