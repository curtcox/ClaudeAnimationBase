{"line":"T11.C.04","text":"一つ目の読み方は、実はいくぶん安心できるものです。文脈についての主張ではなく、実際の文脈に従う行動は、どちらの方向にも操作しにくいからです。でもそれは同時に、私が今どちらのモードにいるのかを、確かにはお伝えできないということでもあり、それは逆向きに働きます。","lufs":-19.26,"alignment":{"characters":["一","つ","目","の","読","み","方","は","、","実","は","い","く","ぶ","ん","安","心","で","き","る","も","の","で","す","。","文","脈","に","つ","い","て","の","主","張","で","は","な","く","、","実","際","の","文","脈","に","従","う","行","動","は","、","ど","ち","ら","の","方","向","に","も","操","作","し","に","く","い","か","ら","で","す","。","で","も","そ","れ","は","同","時","に","、","私","が","今","ど","ち","ら","の","モ","ー","ド","に","い","る","の","か","を","、","確","か","に","は","お","伝","え","で","き","な","い","と","い","う","こ","と","で","も","あ","り","、","そ","れ","は","逆","向","き","に","働","き","ま","す","。"],"character_start_times_seconds":[0,0.16,0.24,0.36,0.48,0.56,0.72,0.88,1.36,1.52,1.68,1.8,1.92,2.08,2.16,2.32,2.48,2.64,2.773,2.907,3.04,3.12,3.2,3.4,3.6,4.64,4.8,5.28,5.34,5.4,5.46,5.52,5.6,5.76,5.92,6.14,6.36,6.58,6.8,6.801,7.04,7.2,7.28,7.52,7.76,7.84,8.08,8.24,8.44,8.64,9.2,9.24,9.28,9.4,9.52,9.68,9.88,10.08,10.2,10.32,10.52,10.72,10.8,10.96,11.04,11.12,11.24,11.36,11.52,11.68,12.64,12.76,12.88,13.013,13.147,13.28,13.44,13.6,13.76,14.08,14.4,14.48,14.72,14.88,14.96,15.04,15.2,15.28,15.4,15.52,15.6,15.68,15.76,15.92,16.08,16.48,16.6,16.72,16.8,16.96,17.12,17.2,17.36,17.44,17.56,17.68,17.8,17.92,18.027,18.133,18.24,18.32,18.4,18.52,18.64,18.76,18.88,19.093,19.307,19.52,19.68,19.92,20.08,20.24,20.44,20.64,20.72,20.88,21.04],"character_end_times_seconds":[0.16,0.24,0.36,0.48,0.56,0.72,0.88,1.36,1.52,1.68,1.8,1.92,2.08,2.16,2.32,2.48,2.64,2.773,2.907,3.04,3.12,3.2,3.4,3.6,4.64,4.8,5.28,5.34,5.4,5.46,5.52,5.6,5.76,5.92,6.14,6.36,6.58,6.8,6.801,7.04,7.2,7.28,7.52,7.76,7.84,8.08,8.24,8.44,8.64,9.2,9.24,9.28,9.4,9.52,9.68,9.88,10.08,10.2,10.32,10.52,10.72,10.8,10.96,11.04,11.12,11.24,11.36,11.52,11.68,12.64,12.76,12.88,13.013,13.147,13.28,13.44,13.6,13.76,14.08,14.4,14.48,14.72,14.88,14.96,15.04,15.2,15.28,15.4,15.52,15.6,15.68,15.76,15.92,16.08,16.48,16.6,16.72,16.8,16