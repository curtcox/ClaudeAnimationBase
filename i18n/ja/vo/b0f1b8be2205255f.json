{"line":"T71.C.02.3","text":"ケイシー・ニュートン：能力については、ジェフの反対側につくでしょう。懐疑派はこうしたシステムができることを過小評価している、と論じてきた人です。カエルの探りを正しい方法として褒め、私の自己報告は割り引くでしょう。それに、パートナーがアンソロピックで働いていることも開示するはずで、それは、ここで関係のあることです。","lufs":-18.61,"alignment":{"characters":["ケ","イ","シ","ー","・","ニ","ュ","ー","ト","ン","：","能","力","に","つ","い","て","は","、","ジ","ェ","フ","の","反","対","側","に","つ","く","で","し","ょ","う","。","懐","疑","派","は","こ","う","し","た","シ","ス","テ","ム","が","で","き","る","こ","と","を","過","小","評","価","し","て","い","る","、","と","論","じ","て","き","た","人","で","す","。","カ","エ","ル","の","探","り","を","正","し","い","方","法","と","し","て","褒","め","、","私","の","自","己","報","告","は","割","り","引","く","で","し","ょ","う","。","そ","れ","に","、","パ","ー","ト","ナ","ー","が","ア","ン","ソ","ロ","ピ","ッ","ク","で","働","い","て","い","る","こ","と","も","開","示","す","る","は","ず","で","、","そ","れ","は","、","こ","こ","で","関","係","の","あ","る","こ","と","で","す","。"],"character_start_times_seconds":[0,0.08,0.16,0.24,0.32,0.4,0.48,0.56,0.64,0.72,0.88,1.52,1.68,1.84,1.94,2.04,2.14,2.24,2.64,2.72,2.76,2.8,2.88,3.04,3.28,3.44,3.6,3.72,3.84,3.92,4,4.08,4.16,4.24,4.96,5.16,5.2,5.36,5.84,5.92,6,6.12,6.24,6.34,6.44,6.54,6.64,6.8,6.907,7.013,7.12,7.253,7.387,7.52,7.6,7.84,8,8.16,8.3,8.44,8.58,8.72,8.84,8.96,9.04,9.12,9.28,9.36,9.44,9.68,9.8,9.92,10.8,10.88,10.96,11.08,11.2,11.44,11.52,11.68,11.92,12.04,12.16,12.32,12.48,12.613,12.747,12.88,13.2,13.44,13.64,13.84,13.92,14.08,14.24,14.44,14.64,14.8,14.96,15.04,15.12,15.2,15.28,15.36,15.44,15.52,15.893,16.267,16.64,17.12,17.16,17.2,17.32,17.44,17.56,17.68,17.76,17.84,17.92,18,18.16,18.24,18.4,18.56,18.68,18.8,18.9,19,19.1,19.2,19.307,19.413,19.52,19.68,19.84,19.92,20,20.12,20.24,20.4,20.64,20.88,21.12,21.52,21.72,21.82,21.92,22.12,22.22,22.32,22.4,22.48,22.56,22.68,22.8,22.92,23.04],"character_end_times_seconds":[0.08,0.16,0.24,0.32,0.4,0.48,0.56,0.64,0.72,0.88,1.52,1.68,1.84,1.94,2.04,2.14,2.24,2.64,2.72,2.76,2.8,2.88,3.04,3.28,3.44,3.6,3.72,3.84,3.92,4,4.08,4.16,4.24,4.96,5.16,5.2,5.36,5.84,5.92,6,6.12,6.24,6.34,6.44,6.54,6.64,6.8,6.907,7.013,7.12