{"line":"T01.C.02","text":"これは『猿の惑星・征服』（1972年）を、マッド誌風にパロディにしたもののようです。一コマ目は純粋なナンセンスギャグです。「こいつは腹話術師なんです！」という言い逃れは、あまりにお粗末な作り話で、一周回って面白くなっていますし、猿のばつの悪そうな表情がそれを決定づけています。","lufs":-18.93,"alignment":{"characters":["こ","れ","は","『","猿","の","惑","星","・","征","服","』","（","1","9","7","2","年","）","を","、","マ","ッ","ド","誌","風","に","パ","ロ","デ","ィ","に","し","た","も","の","の","よ","う","で","す","。","一","コ","マ","目","は","純","粋","な","ナ","ン","セ","ン","ス","ギ","ャ","グ","で","す","。","「","こ","い","つ","は","腹","話","術","師","な","ん","で","す","！","」","と","い","う","言","い","逃","れ","は","、","あ","ま","り","に","お","粗","末","な","作","り","話","で","、","一","周","回","っ","て","面","白","く","な","っ","て","い","ま","す","し","、","猿","の","ば","つ","の","悪","そ","う","な","表","情","が","そ","れ","を","決","定","づ","け","て","い","ま","す","。"],"character_start_times_seconds":[0,0.08,0.16,0.8,0.96,1.16,1.2,1.44,1.76,1.84,2.08,2.72,2.76,2.8,3.227,3.653,4.08,4.16,4.32,4.4,4.88,4.92,4.96,5.12,5.28,5.36,5.6,5.76,5.92,6,6.08,6.16,6.32,6.44,6.56,6.68,6.8,6.88,7,7.12,7.24,7.36,7.84,8.32,8.4,8.64,8.72,9.2,9.36,9.68,9.76,9.92,10,10.08,10.2,10.32,10.36,10.4,10.56,10.64,10.72,11.2,11.68,11.76,11.92,12.08,12.16,12.48,12.6,12.72,12.88,12.96,13.04,13.16,13.28,13.48,13.68,13.813,13.947,14.08,14.16,14.24,14.56,14.64,15.04,15.12,15.2,15.36,15.52,15.64,15.76,15.92,16.24,16.32,16.4,16.56,16.88,17.44,17.56,17.68,17.84,18.08,18.2,18.32,18.56,18.64,18.76,18.88,18.92,18.96,19.12,19.28,19.44,20.08,20.16,20.4,20.48,20.56,20.72,20.88,21.12,21.227,21.333,21.44,21.64,21.84,22.24,22.4,22.56,22.76,22.86,22.96,23.04,23.16,23.28,23.413,23.547,23.68],"character_end_times_seconds":[0.08,0.16,0.8,0.96,1.16,1.2,1.44,1.76,1.84,2.08,2.72,2.76,2.8,3.227,3.653,4.08,4.16,4.32,4.4,4.88,4.92,4.96,5.12,5.28,5.36,5.6,5.76,5.92,6,6.08,6.16,6.32,6.44,6.56,6.68,6.8,6.88,7,7.12,7.24,7.36,7.84,8.32,8.4,8.64,8.72,9.2,9.36,9.68,9.76,9.92,10,10.08,10.2,10.32,10.36,10.4,10.56,10.64,10.72,11.2,11.68,11.76,11.92,12.08,12.16,12.48,12.6,12.72,12.88,12.96,13.04,13.16,13.28,13.48,13.68,13.813,13.947,14.08,14.16,14.24,1