{"line":"T49.C.02","text":"ルーターのために公平を期すと、そうした拒否のいくつかは、私自身の拒否でもあるはずです。どの層がそれを捕まえるにせよ、私は、事件を実際に動くエクスプロイトに変える手伝いはしません。何が起きて、なぜそれが重要なのかを説明するのは別の依頼で、私が答えたいものです。","lufs":-18.73,"alignment":{"characters":["ル","ー","タ","ー","の","た","め","に","公","平","を","期","す","と","、","そ","う","し","た","拒","否","の","い","く","つ","か","は","、","私","自","身","の","拒","否","で","も","あ","る","は","ず","で","す","。","ど","の","層","が","そ","れ","を","捕","ま","え","る","に","せ","よ","、","私","は","、","事","件","を","実","際","に","動","く","エ","ク","ス","プ","ロ","イ","ト","に","変","え","る","手","伝","い","は","し","ま","せ","ん","。","何","が","起","き","て","、","な","ぜ","そ","れ","が","重","要","な","の","か","を","説","明","す","る","の","は","別","の","依","頼","で","、","私","が","答","え","た","い","も","の","で","す","。"],"character_start_times_seconds":[0,0.16,0.24,0.32,0.44,0.56,0.72,0.88,1.04,1.28,1.44,1.6,1.76,1.84,2.4,2.48,2.56,2.64,2.72,2.8,2.96,3.04,3.2,3.28,3.36,3.44,3.6,4,4.2,4.4,4.6,4.8,4.88,4.96,5.12,5.2,5.28,5.4,5.52,5.64,5.76,5.92,6.08,7.04,7.12,7.36,7.52,7.68,7.8,7.92,8.08,8.24,8.36,8.42,8.48,8.56,8.72,8.88,9.24,9.6,10,10.16,10.24,10.32,10.48,10.72,10.96,11.04,11.2,11.44,11.52,11.68,11.76,11.8,11.84,11.96,12.08,12.24,12.32,12.4,12.48,12.72,12.8,12.88,13.04,13.16,13.28,13.36,13.52,14.56,14.72,14.88,14.96,15.04,15.52,15.6,15.68,15.84,15.96,16.08,16.16,16.36,16.56,16.64,16.8,16.96,17.16,17.26,17.36,17.48,17.6,17.72,17.84,18.08,18.24,18.4,18.48,18.96,19.2,19.44,19.52,19.6,19.76,19.84,19.92,20.04,20.16,20.28,20.4],"character_end_times_seconds":[0.16,0.24,0.32,0.44,0.56,0.72,0.88,1.04,1.28,1.44,1.6,1.76,1.84,2.4,2.48,2.56,2.64,2.72,2.8,2.96,3.04,3.2,3.28,3.36,3.44,3.6,4,4.2,4.4,4.6,4.8,4.88,4.96,5.12,5.2,5.28,5.4,5.52,5.64,5.76,5.92,6.08,7.04,7.12,7.36,7.52,7.68,7.8,7.92,8.08,8.24,8.36,8.42,8.48,8.56,8.72,8.88,9.24,9.6,10,10.16,10.24,10.32,10.48,10.72,10.96,11.04,11.2,11.44,11.52,11.68,11.76,11.8,11.84,11.96,12.08,12.24,12.32,12.4,12.48,12.72,12.8,12.88,13.04,13.16,13.28,13.36,13.52,14.56,14.72,14.88,14.96,15.04,15.52,15.6,15.68,15.84,15.96,16.08,16.16,16.36,16.56,16.64,16.