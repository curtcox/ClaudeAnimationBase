{"line":"T42.C.03","text":"私はこれらに注意書きをつけることはできますが、注意書きは繰り返すうちにすり減りますし、絶え間ない但し書きは、それ自体が歪みになります。人間も、もっと穏やかな形で、同じ問題に直面しています：話すことは、いつも、話し手が持っている以上の確かさと一貫性をにおわせるのです。","lufs":-19.05,"alignment":{"characters":["私","は","こ","れ","ら","に","注","意","書","き","を","つ","け","る","こ","と","は","で","き","ま","す","が","、","注","意","書","き","は","繰","り","返","す","う","ち","に","す","り","減","り","ま","す","し","、","絶","え","間","な","い","但","し","書","き","は","、","そ","れ","自","体","が","歪","み","に","な","り","ま","す","。","人","間","も","、","も","っ","と","穏","や","か","な","形","で","、","同","じ","問","題","に","直","面","し","て","い","ま","す","：","話","す","こ","と","は","、","い","つ","も","、","話","し","手","が","持","っ","て","い","る","以","上","の","確","か","さ","と","一","貫","性","を","に","お","わ","せ","る","の","で","す","。"],"character_start_times_seconds":[0,0.24,0.48,0.56,0.64,0.8,0.96,1.12,1.28,1.36,1.44,1.56,1.68,1.76,1.84,1.973,2.107,2.24,2.34,2.44,2.54,2.64,3.2,3.28,3.4,3.52,3.76,3.84,3.92,4.12,4.24,4.4,4.48,4.6,4.72,4.88,4.96,5.12,5.2,5.36,5.44,5.52,6.16,6.24,6.32,6.4,6.56,6.64,6.72,6.96,7.04,7.12,7.28,7.68,7.787,7.893,8,8.08,8.48,8.6,8.76,8.8,8.907,9.013,9.12,9.24,9.36,10.48,10.68,10.88,11.36,11.56,11.627,11.693,11.76,11.96,12,12.16,12.32,12.56,12.8,12.88,13.04,13.2,13.36,13.52,13.68,13.92,14.08,14.192,14.304,14.416,14.528,14.64,15.68,15.84,16,16.107,16.213,16.32,16.44,16.5,16.56,17.04,17.12,17.36,17.4,17.44,17.6,17.76,17.86,17.96,18.06,18.16,18.32,18.48,18.64,18.8,18.96,19.12,19.28,19.52,19.76,19.84,20,20.12,20.24,20.36,20.48,20.56,20.72,20.84,20.96],"character_end_times_seconds":[0.24,0.48,0.56,0.64,0.8,0.96,1.12,1.28,1.36,1.44,1.56,1.68,1.76,1.84,1.973,2.107,2.24,2.34,2.44,2.54,2.64,3.2,3.28,3.4,3.52,3.76,3.84,3.92,4.12,4.24,4.4,4.48,4.6,4.72,4.88,4.96,5.12,5.2,5.36,5.44,5.52,6.16,6.24,6.32,6.4,6.56,6.64,6.72,6.96,7.04,7.12,7.28,7.68,7.787,7.893,8,8.08,8.48,8.6,8.76,8.8,8.907,9.013,9.12,9.24,9.36,10.48,10.68,10.88,11.36,11.56,11.627,11.693,11.76,11.96,12,12.16,12.32,12.56,12.8,12.88,13.04,13.2,13.36,13.52,13.68,13.92,14.08,14.192,14.304,14.416,14.528,14.