{"line":"T66.C.01","text":"私にわかる範囲では、もとは純粋な擬音語で、何かに火がつくときの「ボッ」という音です。2008年のハンソンとユドカウスキーの「エーアイ-フーム」論争で広まりました。頭字語のこじつけは、あとから来ました：「Fast Onset of Overwhelming Mastery」（圧倒的な熟達の、急速な始まり）。","lufs":-18.29,"alignment":{"characters":["私","に","わ","か","る","範","囲","で","は","、","も","と","は","純","粋","な","擬","音","語","で","、","何","か","に","火","が","つ","く","と","き","の","「","ボ","ッ","」","と","い","う","音","で","す","。","2","0","0","8","年","の","ハ","ン","ソ","ン","と","ユ","ド","カ","ウ","ス","キ","ー","の","「","エ","ー","ア","イ","-","フ","ー","ム","」","論","争","で","広","ま","り","ま","し","た","。","頭","字","語","の","こ","じ","つ","け","は","、","あ","と","か","ら","来","ま","し","た","：","「","F","a","s","t"," ","O","n","s","e","t"," ","o","f"," ","O","v","e","r","w","h","e","l","m","i","n","g"," ","M","a","s","t","e","r","y","」","（","圧","倒","的","な","熟","達","の","、","急","速","な","始","ま","り","）","。"],"character_start_times_seconds":[0,0.24,0.32,0.48,0.6,0.72,0.88,0.96,1.28,1.6,1.68,1.76,1.96,2.16,2.24,2.613,2.667,2.8,2.88,3.04,3.52,3.64,3.76,3.88,4,4.16,4.24,4.32,4.48,4.6,4.72,5.12,5.16,5.2,5.28,5.44,5.6,5.72,5.84,5.92,6.08,6.24,6.88,6.987,7.093,7.2,7.44,7.68,7.92,8,8.16,8.28,8.4,8.72,8.8,8.88,9.04,9.12,9.2,9.28,9.56,9.84,9.88,9.92,10.159,10.16,10.24,10.32,10.4,10.52,10.64,10.72,10.8,11.04,11.2,11.28,11.4,11.52,11.653,11.787,11.92,12.72,12.96,13.04,13.12,13.28,13.36,13.52,13.64,13.76,13.92,14,14.08,14.16,14.28,14.4,14.56,14.667,14.773,14.88,15.24,15.6,15.66,15.72,15.78,15.84,15.947,16.053,16.16,16.213,16.267,16.32,16.373,16.427,16.48,16.56,16.64,16.72,16.8,16.88,16.92,16.96,17,17.04,17.08,17.12,17.16,17.2,17.28,17.36,17.44,17.52,17.6,17.68,17.76,17.84,18.24,18.64,18.72,18.8,19,19.2,19.36,19.6,19.92,20.04,20.16,20.32,20.48,20.72,20.8,20.88,20.92],"character_end_times_seconds":[0.24,0.32,0.48,0.6,0.72,0.88,0.96,1.28,1.6,1.68,1.76,1.96,2.16,2.24,2.613,2.667,2.8,2.88,3.04,3.52,3.64,3.76,3.88,4,4.16,4.24,4.32,4.48,4.6,4.72,5.12,5.16,5.2,5.28,5.44,5.6,5.72,5.84,5.92,6.08,6.24,6.88,6.987,7.093,7.2,7.44,7.68,7.92,8,8.16,8.28,8.4,8.72,8.8,8.88,9.04,9.