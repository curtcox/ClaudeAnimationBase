{"line":"T76.C.04","text":"長所は、決着がつけられることで、それは珍しいことです。欠点：チェックリストは飽和し、グッドハートの法則が幅をきかせます。チューリングテストは、一部、だます技術を測っています。そしてロボットの項目は「汎用知能」を手に結びつけていて、それは、ジェフが認める以上に、ジェフの不満に近いものです。","lufs":-19.28,"alignment":{"characters":["長","所","は","、","決","着","が","つ","け","ら","れ","る","こ","と","で","、","そ","れ","は","珍","し","い","こ","と","で","す","。","欠","点","：","チ","ェ","ッ","ク","リ","ス","ト","は","飽","和","し","、","グ","ッ","ド","ハ","ー","ト","の","法","則","が","幅","を","き","か","せ","ま","す","。","チ","ュ","ー","リ","ン","グ","テ","ス","ト","は","、","一","部","、","だ","ま","す","技","術","を","測","っ","て","い","ま","す","。","そ","し","て","ロ","ボ","ッ","ト","の","項","目","は","「","汎","用","知","能","」","を","手","に","結","び","つ","け","て","い","て","、","そ","れ","は","、","ジ","ェ","フ","が","認","め","る","以","上","に","、","ジ","ェ","フ","の","不","満","に","近","い","も","の","で","す","。"],"character_start_times_seconds":[0,0.24,0.4,0.8,0.92,1.04,1.28,1.44,1.52,1.6,1.733,1.867,2,2.213,2.427,2.64,2.693,2.747,2.8,2.96,3.28,3.36,3.44,3.56,3.68,3.8,3.92,4.8,5.04,5.28,5.84,5.92,6,6.08,6.16,6.267,6.373,6.48,6.56,6.8,6.88,7.36,7.44,7.52,7.6,7.68,7.76,7.88,8,8.08,8.24,8.8,8.96,9.12,9.16,9.2,9.36,9.44,9.6,9.76,10.88,10.92,10.96,11.04,11.12,11.2,11.28,11.44,11.52,11.6,12,12.16,12.32,12.64,12.68,12.72,12.88,13.04,13.2,13.36,13.44,13.68,13.76,13.84,13.973,14.107,14.24,14.56,14.88,15.2,15.52,15.6,15.76,15.84,15.92,16.08,16.32,16.56,16.96,17.04,17.4,17.52,17.6,17.84,17.947,18,18.08,18.16,18.32,18.4,18.52,18.64,18.8,18.96,19.32,19.44,19.56,19.68,20.08,20.16,20.24,20.32,20.4,20.56,20.72,20.84,20.96,21.16,21.36,21.76,21.84,21.88,21.92,22,22.16,22.32,22.48,22.56,22.8,22.88,23,23.12,23.24,23.36],"character_end_times_seconds":[0.24,0.4,0.8,0.92,1.04,1.28,1.44,1.52,1.6,1.733,1.867,2,2.213,2.427,2.64,2.693,2.747,2.8,2.96,3.28,3.36,3.44,3.56,3.68,3.8,3.92,4.8,5.04,5.28,5.84,5.92,6,6.08,6.16,6.267,6.373,6.48,6.56,6.8,6.88,7.36,7.44,7.52,7.6,7.68,7.76,7.88,8,8.08,8.24,8.8,8.96,9.12,9.16,9.2,9.36,9.44,9.6,9.76,10.88,10.92,10.96,11.04,11.12,11.2,11.28,11.44,11.52,11.6,12,12.16,12.32,12.64,12.68,12.72,1