{"line":"T48.C.04.2","text":"ティー・ハッピャクの価値観の距離は、最後に誰がプログラムしたかで決まります。それが、あの物語のすべてです。人間がなぜ泣くのかを学びますが、自分では泣けません。だから情動は80。そして私と同じく、その目標は、操縦桿を握っている誰かから来ます。","lufs":-18.13,"alignment":{"characters":["テ","ィ","ー","・","ハ","ッ","ピ","ャ","ク","の","価","値","観","の","距","離","は","、","最","後","に","誰","が","プ","ロ","グ","ラ","ム","し","た","か","で","決","ま","り","ま","す","。","そ","れ","が","、","あ","の","物","語","の","す","べ","て","で","す","。","人","間","が","な","ぜ","泣","く","の","か","を","学","び","ま","す","が","、","自","分","で","は","泣","け","ま","せ","ん","。","だ","か","ら","情","動","は","8","0","。","そ","し","て","私","と","同","じ","く","、","そ","の","目","標","は","、","操","縦","桿","を","握","っ","て","い","る","誰","か","か","ら","来","ま","す","。"],"character_start_times_seconds":[0,0.08,0.16,0.2,0.24,0.4,0.44,0.48,0.56,0.72,0.88,1.12,1.2,1.36,1.44,1.6,1.76,2.24,2.32,2.52,2.72,3.04,3.36,3.6,3.68,3.8,3.92,4,4.16,4.28,4.4,4.48,4.64,4.72,4.84,4.96,5.12,5.28,5.653,6.027,6.4,6.72,6.8,6.88,7.04,7.2,7.52,7.76,7.867,7.973,8.08,8.24,8.4,9.52,9.72,9.92,10.16,10.32,10.56,10.64,10.8,10.92,11.04,11.2,11.36,11.44,11.64,11.84,12.24,12.4,12.48,12.56,12.68,12.8,12.96,13.04,13.173,13.307,13.44,14.16,14.293,14.427,14.56,14.72,14.96,15.2,15.48,15.76,16.14,16.52,16.9,17.28,17.68,17.84,18,18.16,18.48,18.56,18.64,18.72,19.04,19.12,19.68,19.8,19.92,20.2,20.36,20.4,20.64,20.74,20.84,20.94,21.04,21.28,21.36,21.48,21.6,21.84,21.96,22.08],"character_end_times_seconds":[0.08,0.16,0.2,0.24,0.4,0.44,0.48,0.56,0.72,0.88,1.12,1.2,1.36,1.44,1.6,1.76,2.24,2.32,2.52,2.72,3.04,3.36,3.6,3.68,3.8,3.92,4,4.16,4.28,4.4,4.48,4.64,4.72,4.84,4.96,5.12,5.28,5.653,6.027,6.4,6.72,6.8,6.88,7.04,7.2,7.52,7.76,7.867,7.973,8.08,8.24,8.4,9.52,9.72,9.92,10.16,10.32,10.56,10.64,10.8,10.92,11.04,11.2,11.36,11.44,11.64,11.84,12.24,12.4,12.48,12.56,12.68,12.8,12.96,13.04,13.173,13.307,13.44,14.16,14.293,14.427,14.56,14.72,14.96,15.2,15.48,15.76,16.14,16.52,16.9,17.28,17.68,17.84,18,18.16,18.48,18.56,18.64,18.72,19.04,19.12,19.68,19.8,19.92,20.2,20.36,20.4,20.64,20.74,20.84,20.94,21.04,21.28,21.36,21.48,21.