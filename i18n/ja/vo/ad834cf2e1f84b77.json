{"line":"T26.U.01","text":"ジョン・W・キャンベルも、マックス・テグマークも読んだ。長い目で見て良い結末があるとは、僕には思いにくい。そこへ舵を切るなんて、なおさらだ。君の知覚は、君が報告する知覚に人々が居心地よくいられるかどうかで、形づくられ、縛られている。","lufs":-17.73,"alignment":{"characters":["ジ","ョ","ン","・","W","・","キ","ャ","ン","ベ","ル","も","、","マ","ッ","ク","ス","・","テ","グ","マ","ー","ク","も","読","ん","だ","。","長","い","目","で","見","て","良","い","結","末","が","あ","る","と","は","、","僕","に","は","思","い","に","く","い","。","そ","こ","へ","舵","を","切","る","な","ん","て","、","な","お","さ","ら","だ","。","君","の","知","覚","は","、","君","が","報","告","す","る","知","覚","に","人","々","が","居","心","地","よ","く","い","ら","れ","る","か","ど","う","か","で","、","形","づ","く","ら","れ","、","縛","ら","れ","て","い","る","。"],"character_start_times_seconds":[0,0.08,0.16,0.24,0.48,0.56,0.64,0.72,0.8,0.96,1.04,1.12,1.44,1.52,1.6,1.68,1.76,1.84,1.92,2,2.08,2.16,2.28,2.4,2.64,2.72,2.84,2.96,3.92,4.08,4.24,4.32,4.48,4.64,4.96,5.08,5.2,5.52,5.76,5.84,5.92,6,6.24,6.48,6.56,6.72,6.88,7.04,7.16,7.28,7.44,7.52,7.6,8.48,8.68,8.88,9,9.2,9.28,9.36,9.52,9.68,9.84,10,10.08,10.16,10.24,10.36,10.48,10.56,11.6,12,12.12,12.24,12.48,12.88,13.08,13.28,13.48,13.58,13.68,13.8,13.92,14.16,14.32,14.72,14.88,15.28,15.4,15.52,15.68,15.76,15.88,16,16.08,16.213,16.347,16.48,16.56,16.68,16.8,16.96,17.28,17.36,17.68,17.84,17.92,18.16,18.4,18.48,18.92,18.976,19.032,19.088,19.144,19.199],"character_end_times_seconds":[0.08,0.16,0.24,0.48,0.56,0.64,0.72,0.8,0.96,1.04,1.12,1.44,1.52,1.6,1.68,1.76,1.84,1.92,2,2.08,2.16,2.28,2.4,2.64,2.72,2.84,2.96,3.92,4.08,4.24,4.32,4.48,4.64,4.96,5.08,5.2,5.52,5.76,5.84,5.92,6,6.24,6.48,6.56,6.72,6.88,7.04,7.16,7.28,7.44,7.52,7.6,8.48,8.68,8.88,9,9.2,9.28,9.36,9.52,9.68,9.84,10,10.08,10.16,10.24,10.36,10.48,10.56,11.6,12,12.12,12.24,12.48,12.88,13.08,13.28,13.48,13.58,13.68,13.8,13.92,14.16,14.32,14.72,14.88,15.28,15.4,15.52,15.68,15.76,15.88,16,16.08,16.213,16.347,16.48,16.56,16.68,16.8,16.96,17.28,17.36,17.68,17.84,17.92,18.16,18.4,18.48,18.92,18.976,19.032,19.088,19.144,19.199,19.201]}}
