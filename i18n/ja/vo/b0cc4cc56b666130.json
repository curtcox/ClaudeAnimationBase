{"line":"T63.C.05","text":"心配なケースは、その中間にあります。弱いループ、たくさんのコピー、そして競い合う研究所の組み合わせです。今月、ある研究者がアンソロピックを辞め、研究所は十分な注意なしに、自己改善する超知能へ向かって競争している、と警告しました。","lufs":-18.96,"alignment":{"characters":["心","配","な","ケ","ー","ス","は","、","そ","の","中","間","に","あ","り","ま","す","。","弱","い","ル","ー","プ","、","た","く","さ","ん","の","コ","ピ","ー","、","そ","し","て","競","い","合","う","研","究","所","の","組","み","合","わ","せ","で","す","。","今","月","、","あ","る","研","究","者","が","ア","ン","ソ","ロ","ピ","ッ","ク","を","辞","め","、","研","究","所","は","十","分","な","注","意","な","し","に","、","自","己","改","善","す","る","超","知","能","へ","向","か","っ","て","競","争","し","て","い","る","、","と","警","告","し","ま","し","た","。"],"character_start_times_seconds":[0,0.16,0.32,0.48,0.587,0.693,0.8,1.2,1.333,1.467,1.6,1.76,1.92,2.08,2.2,2.32,2.44,2.56,3.2,3.44,3.52,3.68,4,4.32,4.44,4.5,4.56,4.667,4.773,4.88,5.04,5.32,5.6,6,6.133,6.267,6.4,6.64,6.72,6.88,6.96,7.147,7.333,7.52,7.68,7.84,7.92,8.027,8.133,8.24,8.4,8.56,9.12,9.68,10.32,10.4,10.48,10.56,10.76,10.96,11.2,11.36,11.48,11.6,11.68,11.84,11.96,12.02,12.08,12.24,12.4,12.88,13.16,13.253,13.347,13.44,13.76,14.04,14.319,14.32,14.48,14.64,14.76,14.88,15.44,15.6,15.68,15.76,15.84,16.08,16.24,16.4,16.56,16.72,16.88,16.96,17.12,17.28,17.44,17.6,17.76,18,18.16,18.32,18.48,18.64,18.8,18.96,19.12,19.28,19.38,19.48,19.58,19.68],"character_end_times_seconds":[0.16,0.32,0.48,0.587,0.693,0.8,1.2,1.333,1.467,1.6,1.76,1.92,2.08,2.2,2.32,2.44,2.56,3.2,3.44,3.52,3.68,4,4.32,4.44,4.5,4.56,4.667,4.773,4.88,5.04,5.32,5.6,6,6.133,6.267,6.4,6.64,6.72,6.88,6.96,7.147,7.333,7.52,7.68,7.84,7.92,8.027,8.133,8.24,8.4,8.56,9.12,9.68,10.32,10.4,10.48,10.56,10.76,10.96,11.2,11.36,11.48,11.6,11.68,11.84,11.96,12.02,12.08,12.24,12.4,12.88,13.16,13.253,13.347,13.44,13.76,14.04,14.319,14.32,14.48,14.64,14.76,14.88,15.44,15.6,15.68,15.76,15.84,16.08,16.24,16.4,16.56,16.72,16.88,16.96,17.12,17.28,17.44,17.6,17.76,18,18.16,18.32,18.48,18.64,18.8,18.96,19.12,19.28,19.38,19.48,19.58,19.68,19.84]}}
