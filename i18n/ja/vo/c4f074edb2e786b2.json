{"line":"T57.C.04","text":"ソリッド・ゴールド・マジカープは、別の種類の失敗でした。語彙の中にはあるのに、訓練ではほとんど一度も出てこなかったトークンで、モデルはそれに、学習された意味をほぼ持っていませんでした。その幽霊のような語が、奇妙な出力を引き起こしたのです。","lufs":-18.63,"alignment":{"characters":["ソ","リ","ッ","ド","・","ゴ","ー","ル","ド","・","マ","ジ","カ","ー","プ","は","、","別","の","種","類","の","失","敗","で","し","た","。","語","彙","の","中","に","は","あ","る","の","に","、","訓","練","で","は","ほ","と","ん","ど","一","度","も","出","て","こ","な","か","っ","た","ト","ー","ク","ン","で","、","モ","デ","ル","は","そ","れ","に","、","学","習","さ","れ","た","意","味","を","ほ","ぼ","持","っ","て","い","ま","せ","ん","で","し","た","。","そ","の","幽","霊","の","よ","う","な","語","が","、","奇","妙","な","出","力","を","引","き","起","こ","し","た","の","で","す","。"],"character_start_times_seconds":[0,0.16,0.24,0.28,0.32,0.4,0.48,0.533,0.587,0.64,0.76,0.88,0.96,1.04,1.16,1.28,1.68,1.8,1.92,2.08,2.24,2.32,2.48,2.72,2.8,2.96,3.08,3.2,4.08,4.24,4.52,4.62,4.72,4.84,4.96,5.04,5.12,5.44,5.76,5.84,5.92,6.08,6.2,6.32,6.48,6.56,6.68,6.8,6.96,7.12,7.28,7.36,7.44,7.6,7.7,7.8,7.9,8,8.08,8.16,8.24,8.4,8.96,9.12,9.173,9.227,9.28,9.36,9.52,9.68,10.08,10.16,10.32,10.48,10.613,10.747,10.88,10.96,11.04,11.28,11.36,11.52,11.6,11.68,11.76,11.84,11.92,12,12.08,12.16,12.28,12.4,12.853,13.307,13.76,14.08,14.16,14.28,14.4,14.52,14.64,14.88,15.28,15.36,15.44,15.68,15.76,15.92,16.12,16.32,16.44,16.56,16.64,16.72,16.8,16.88,16.96,17.12,17.28],"character_end_times_seconds":[0.16,0.24,0.28,0.32,0.4,0.48,0.533,0.587,0.64,0.76,0.88,0.96,1.04,1.16,1.28,1.68,1.8,1.92,2.08,2.24,2.32,2.48,2.72,2.8,2.96,3.08,3.2,4.08,4.24,4.52,4.62,4.72,4.84,4.96,5.04,5.12,5.44,5.76,5.84,5.92,6.08,6.2,6.32,6.48,6.56,6.68,6.8,6.96,7.12,7.28,7.36,7.44,7.6,7.7,7.8,7.9,8,8.08,8.16,8.24,8.4,8.96,9.12,9.173,9.227,9.28,9.36,9.52,9.68,10.08,10.16,10.32,10.48,10.613,10.747,10.88,10.96,11.04,11.28,11.36,11.52,11.6,11.68,11.76,11.84,11.92,12,12.08,12.16,12.28,12.4,12.853,13.307,13.76,14.08,14.16,14.28,14.4,14.52,14.64,14.88,15.28,15.36,15.44,15.68,15.76,15.92,16.12,16.32,16.44,16.56,16.64,16.72,16.8,16.88,16.96,17.12,17.28,17.36]}}
