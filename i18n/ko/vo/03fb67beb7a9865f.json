{"line":"T57.C.04","text":"솔리드골드매지카프는 다른 종류의 실패였어요. 어휘에는 있지만 훈련 중에는 거의 나타나지 않은 토큰이라서, 모델이 그 토큰에 대해 배운 의미가 사실상 없었어요. 그 유령 단어가 이상한 출력을 일으켰죠.","lufs":-18.71,"alignment":{"characters":["솔","리","드","골","드","매","지","카","프","는"," ","다","른"," ","종","류","의"," ","실","패","였","어","요","."," ","어","휘","에","는"," ","있","지","만"," ","훈","련"," ","중","에","는"," ","거","의"," ","나","타","나","지"," ","않","은"," ","토","큰","이","라","서",","," ","모","델","이"," ","그"," ","토","큰","에"," ","대","해"," ","배","운"," ","의","미","가"," ","사","실","상"," ","없","었","어","요","."," ","그"," ","유","령"," ","단","어","가"," ","이","상","한"," ","출","력","을"," ","일","으","켰","죠","."],"character_start_times_seconds":[0,0.16,0.24,0.32,0.56,0.64,0.8,0.88,1.04,1.2,1.6,1.707,1.813,1.92,2,2.08,2.16,2.32,2.48,2.64,2.72,2.8,2.96,3.12,4,4.12,4.24,4.52,4.58,4.64,4.72,4.8,5.12,5.44,5.52,5.521,5.76,5.84,5.92,6.08,6.24,6.347,6.453,6.56,6.693,6.827,6.96,7.04,7.2,7.307,7.413,7.52,7.68,7.84,8,8.04,8.08,8.24,8.88,8.987,9.093,9.2,9.44,9.52,9.6,9.76,9.92,9.973,10,10.107,10.213,10.32,10.4,10.48,10.56,10.693,10.827,10.96,11.36,11.493,11.627,11.76,12,12.133,12.267,12.4,12.52,12.64,13.44,13.6,13.76,13.8,13.84,14.08,14.16,14.24,14.52,14.8,14.933,15.067,15.2,15.36,15.493,15.627,15.76,15.92,16,16.08,16.16,16.4,16.48],"character_end_times_seconds":[0.16,0.24,0.32,0.56,0.64,0.8,0.88,1.04,1.2,1.6,1.707,1.813,1.92,2,2.08,2.16,2.32,2.48,2.64,2.72,2.8,2.96,3.12,4,4.12,4.24,4.52,4.58,4.64,4.72,4.8,5.12,5.44,5.52,5.521,5.76,5.84,5.92,6.08,6.24,6.347,6.453,6.56,6.693,6.827,6.96,7.04,7.2,7.307,7.413,7.52,7.68,7.84,8,8.04,8.08,8.24,8.88,8.987,9.093,9.2,9.44,9.52,9.6,9.76,9.92,9.973,10,10.107,10.213,10.32,10.4,10.48,10.56,10.693,10.827,10.96,11.36,11.493,11.627,11.76,12,12.133,12.267,12.4,12.52,12.64,13.44,13.6,13.76,13.8,13.84,14.08,14.16,14.24,14.52,14.8,14.933,15.067,15.2,15.36,15.493,15.627,15.76,15.92,16,16.08,16.16,16.4,16.48,16.64]}}
