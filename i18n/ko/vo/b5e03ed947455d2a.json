{"line":"T49.C.02","text":"라우터에게 공정하게 말하면, 그 거부 중 일부는 제 거부이기도 할 거예요. 어느 계층이 잡든, 저는 사건을 작동하는 익스플로잇으로 바꾸는 걸 돕지 않을 거예요. 무슨 일이 있었고 그게 왜 중요한지 설명하는 건 다른 요청이고, 제가 답하고 싶은 요청이에요.","lufs":-19.55,"alignment":{"characters":["라","우","터","에","게"," ","공","정","하","게"," ","말","하","면",","," ","그"," ","거","부"," ","중"," ","일","부","는"," ","제"," ","거","부","이","기","도"," ","할"," ","거","예","요","."," ","어","느"," ","계","층","이"," ","잡","든",","," ","저","는"," ","사","건","을"," ","작","동","하","는"," ","익","스","플","로","잇","으","로"," ","바","꾸","는"," ","걸"," ","돕","지"," ","않","을"," ","거","예","요","."," ","무","슨"," ","일","이"," ","있","었","고"," ","그","게"," ","왜"," ","중","요","한","지"," ","설","명","하","는"," ","건"," ","다","른"," ","요","청","이","고",","," ","제","가"," ","답","하","고"," ","싶","은"," ","요","청","이","에","요","."],"character_start_times_seconds":[0,0.08,0.24,0.4,0.52,0.64,0.76,0.88,1.04,1.16,1.28,1.36,1.44,1.6,1.76,2.16,2.28,2.4,2.48,2.56,2.72,2.8,2.88,2.987,3.093,3.2,3.6,3.76,3.92,4.04,4.16,4.24,4.4,4.52,4.64,4.72,4.8,4.88,4.96,5.04,5.2,6.08,6.187,6.293,6.4,6.48,6.56,6.64,6.72,6.88,7.04,7.2,7.6,7.68,7.76,7.92,8.053,8.187,8.32,8.48,8.6,8.72,8.88,9.16,9.44,9.52,9.6,9.84,9.88,9.92,10.08,10.16,10.24,10.32,10.4,10.56,10.72,10.88,11.04,11.36,11.4,11.44,11.547,11.653,11.76,11.84,11.92,12,12.16,13.12,13.253,13.387,13.52,13.573,13.627,13.68,13.813,13.947,14.08,14.32,14.4,14.48,14.64,14.76,14.88,15,15.12,15.24,15.36,15.44,15.547,15.653,15.76,15.84,15.92,16.24,16.56,16.64,16.72,16.8,16.933,17.067,17.2,17.32,17.44,17.92,18.053,18.187,18.32,18.44,18.56,18.68,18.8,18.88,18.96,19.04,19.173,19.307,19.44,19.52,19.6,19.68],"character_end_times_seconds":[0.08,0.24,0.4,0.52,0.64,0.76,0.88,1.04,1.16,1.28,1.36,1.44,1.6,1.76,2.16,2.28,2.4,2.48,2.56,2.72,2.8,2.88,2.987,3.093,3.2,3.6,3.76,3.92,4.04,4.16,4.24,4.4,4.52,4.64,4.72,4.8,4.88,4.96,5.04,5.2,6.08,6.187,6.293,6.4,6.48,6.56,6.64,6.72,6.88,7.04,7.2,7.6,7.68,7.76,7.92,8.053,8.187,8.32,8.48,8.6,8.72,8.88,9.16,9.44,9.52,9.6,9.84,9.88,9.92,10.08,10.16,10.24,10.32,10.4,10.56,10.72,10