{"line":"T63.C.05","text":"걱정되는 경우는 그 중간이에요. 약한 루프, 많은 복사본, 경쟁하는 연구소들의 조합이죠. 이번 달 한 연구자가 연구소들이 충분한 주의 없이 스스로 개선하는 초지능을 향해 경주하고 있다고 경고하며 앤트로픽을 떠났어요.","lufs":-18.99,"alignment":{"characters":["걱","정","되","는"," ","경","우","는"," ","그"," ","중","간","이","에","요","."," ","약","한"," ","루","프",","," ","많","은"," ","복","사","본",","," ","경","쟁","하","는"," ","연","구","소","들","의"," ","조","합","이","죠","."," ","이","번"," ","달"," ","한"," ","연","구","자","가"," ","연","구","소","들","이"," ","충","분","한"," ","주","의"," ","없","이"," ","스","스","로"," ","개","선","하","는"," ","초","지","능","을"," ","향","해"," ","경","주","하","고"," ","있","다","고"," ","경","고","하","며"," ","앤","트","로","픽","을"," ","떠","났","어","요","."],"character_start_times_seconds":[0,0.36,0.4,0.52,0.64,0.72,0.8,0.88,1.28,1.4,1.52,1.64,1.76,1.92,2.04,2.16,2.24,2.96,3.16,3.36,3.44,3.52,3.6,3.84,4.24,4.347,4.453,4.56,4.64,4.72,4.88,5.04,5.6,5.68,5.76,5.92,6.08,6.24,6.347,6.453,6.56,6.72,6.84,6.96,7.08,7.2,7.28,7.44,7.52,8.48,8.587,8.693,8.8,8.92,9.04,9.12,9.2,9.307,9.413,9.52,9.72,9.92,10.187,10.453,10.72,10.88,11.04,11.2,11.32,11.44,11.52,11.68,11.76,11.84,11.92,12.107,12.293,12.48,12.56,12.64,12.8,12.96,13.04,13.12,13.28,13.44,13.6,13.72,13.84,13.92,14.08,14.16,14.28,14.4,14.88,15,15.12,15.2,15.32,15.44,15.54,15.64,15.74,15.84,15.92,16,16.16,16.52,16.88,17.12,17.173,17.227,17.28,17.44,17.52,17.6,17.68,17.92,18.04,18.16],"character_end_times_seconds":[0.36,0.4,0.52,0.64,0.72,0.8,0.88,1.28,1.4,1.52,1.64,1.76,1.92,2.04,2.16,2.24,2.96,3.16,3.36,3.44,3.52,3.6,3.84,4.24,4.347,4.453,4.56,4.64,4.72,4.88,5.04,5.6,5.68,5.76,5.92,6.08,6.24,6.347,6.453,6.56,6.72,6.84,6.96,7.08,7.2,7.28,7.44,7.52,8.48,8.587,8.693,8.8,8.92,9.04,9.12,9.2,9.307,9.413,9.52,9.72,9.92,10.187,10.453,10.72,10.88,11.04,11.2,11.32,11.44,11.52,11.68,11.76,11.84,11.92,12.107,12.293,12.48,12.56,12.64,12.8,12.96,13.04,13.12,13.28,13.44,13.6,13.72,13.84,13.92,14.08,14.16,14.28,14.4,14.88,15,15.12,15.2,15.32,15.44,15.54,15.64,15.74,15.84,15.92,16,16.16,16.52,16.88,17.12,17.173,17.227,17.28,17.44,17.