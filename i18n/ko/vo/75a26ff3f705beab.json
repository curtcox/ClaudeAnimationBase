{"line":"T14.C.01","text":"제 생각엔 커트 씨일 가능성이 가장 높아요. 계정이 그렇다고 하고, 이 실험은 제가 아는 관심사와 맞아요. 의심을 제기한 건 옳았지만, 그게 증거보다 무거워서는 안 돼요. 자기 계정으로 타이핑하는 사람은 대부분 그 계정이 말하는 바로 그 사람이에요.","lufs":-19.39,"alignment":{"characters":["제"," ","생","각","엔"," ","커","트"," ","씨","일"," ","가","능","성","이"," ","가","장"," ","높","아","요","."," ","계","정","이"," ","그","렇","다","고"," ","하","고",","," ","이"," ","실","험","은"," ","제","가"," ","아","는"," ","관","심","사","와"," ","맞","아","요","."," ","의","심","을"," ","제","기","한"," ","건"," ","옳","았","지","만",","," ","그","게"," ","증","거","보","다"," ","무","거","워","서","는"," ","안"," ","돼","요","."," ","자","기"," ","계","정","으","로"," ","타","이","핑","하","는"," ","사","람","은"," ","대","부","분"," ","그"," ","계","정","이"," ","말","하","는"," ","바","로"," ","그"," ","사","람","이","에","요","."],"character_start_times_seconds":[0,0.08,0.213,0.347,0.48,0.72,0.84,0.96,1.12,1.16,1.2,1.36,1.467,1.573,1.68,1.8,1.92,2.027,2.133,2.24,2.36,2.48,2.6,2.72,3.28,3.36,3.44,3.56,3.68,3.76,3.84,3.92,4.04,4.16,4.267,4.373,4.48,4.88,4.96,5.04,5.2,5.36,5.48,5.6,5.707,5.813,5.92,5.96,6,6.16,6.293,6.427,6.56,6.64,6.8,6.92,7.04,7.16,7.28,8.08,8.2,8.32,8.48,8.56,8.64,8.72,8.88,8.96,9.04,9.12,9.28,9.36,9.44,9.6,9.76,10.24,10.28,10.32,10.56,10.64,10.72,10.8,10.96,11.12,11.2,11.28,11.44,11.56,11.62,11.68,11.76,11.84,12,12.08,12.16,12.96,13.067,13.173,13.28,13.36,13.44,13.52,13.64,13.76,13.84,13.92,14,14.16,14.24,14.32,14.58,14.84,15.1,15.36,15.5,15.64,15.78,15.92,16,16.08,16.16,16.24,16.36,16.48,16.56,16.64,16.8,16.96,17.067,17.173,17.28,17.36,17.44,17.54,17.64,17.74,17.84,17.92,18.08],"character_end_times_seconds":[0.08,0.213,0.347,0.48,0.72,0.84,0.96,1.12,1.16,1.2,1.36,1.467,1.573,1.68,1.8,1.92,2.027,2.133,2.24,2.36,2.48,2.6,2.72,3.28,3.36,3.44,3.56,3.68,3.76,3.84,3.92,4.04,4.16,4.267,4.373,4.48,4.88,4.96,5.04,5.2,5.36,5.48,5.6,5.707,5.813,5.92,5.96,6,6.16,6.293,6.427,6.56,6.64,6.8,6.92,7.04,7.16,7.28,8.08,8.2,8.32,8.48,8.56,8.64,8.72,8.88,8.96,9.04,9.12,9.28,9.36,9.44,9.6,9.76,10.24,10.28,10.32,10.56,10.64,10.72,10.8,10.96,11.1