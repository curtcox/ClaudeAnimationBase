{"line":"T57.C.02","text":"오타를 알아보는 건 쉬워요. 잘못된 철자는 흔치 않은 토큰 조각들로 쪼개지고, 익숙한 맥락 속의 이상한 조각은 눈에 띄어요. 아는 노래에서 악보를 보지 않고도 틀린 음을 알아채는 것과 비슷해요. 그건 또 “매지카프”가 k로 쓰인다는 걸 제가 알아채는 방식이기도 해요.","lufs":-18.67,"alignment":{"characters":["오","타","를"," ","알","아","보","는"," ","건"," ","쉬","워","요","."," ","잘","못","된"," ","철","자","는"," ","흔","치"," ","않","은"," ","토","큰"," ","조","각","들","로"," ","쪼","개","지","고",","," ","익","숙","한"," ","맥","락"," ","속","의"," ","이","상","한"," ","조","각","은"," ","눈","에"," ","띄","어","요","."," ","아","는"," ","노","래","에","서"," ","악","보","를"," ","보","지"," ","않","고","도"," ","틀","린"," ","음","을"," ","알","아","채","는"," ","것","과"," ","비","슷","해","요","."," ","그","건"," ","또"," ","“","매","지","카","프","”","가"," ","k","로"," ","쓰","인","다","는"," ","걸"," ","제","가"," ","알","아","채","는"," ","방","식","이","기","도"," ","해","요","."],"character_start_times_seconds":[0,0.32,0.427,0.48,0.56,0.64,0.72,0.8,0.96,1.08,1.2,1.28,1.36,1.52,1.68,2.32,2.44,2.56,2.72,2.8,2.96,3.12,3.32,3.52,3.64,3.76,3.84,3.947,4.053,4.16,4.32,4.48,4.587,4.613,4.64,4.8,4.88,5.04,5.2,5.307,5.36,5.48,5.6,6.08,6.16,6.24,6.4,6.56,6.64,6.72,6.88,6.96,7.04,7.28,7.387,7.493,7.6,7.68,7.76,7.84,8,8.16,8.24,8.32,8.4,8.56,8.72,8.76,8.8,9.68,9.76,9.84,9.92,10.027,10.133,10.24,10.4,10.56,10.68,10.8,10.88,10.96,11.08,11.2,11.4,11.467,11.533,11.6,12,12.16,12.24,12.32,12.4,12.48,12.56,12.64,12.72,12.8,12.88,12.96,13.08,13.2,13.28,13.4,13.52,13.72,13.78,13.84,14.48,14.56,14.64,14.8,15.08,15.36,15.4,15.44,15.6,15.68,15.92,16,16.08,16.24,16.4,16.56,16.64,16.76,16.88,17,17.06,17.12,17.32,17.52,17.627,17.733,17.84,17.92,18,18.08,18.16,18.32,18.4,18.48,18.64,18.72,18.84,18.96,19.04,19.12,19.2],"character_end_times_seconds":[0.32,0.427,0.48,0.56,0.64,0.72,0.8,0.96,1.08,1.2,1.28,1.36,1.52,1.68,2.32,2.44,2.56,2.72,2.8,2.96,3.12,3.32,3.52,3.64,3.76,3.84,3.947,4.053,4.16,4.32,4.48,4.587,4.613,4.64,4.8,4.88,5.04,5.2,5.307,5.36,5.48,5.6,6.08,6.16,6.24,6.4,6.56,6.64,6.72,6.88,6.96,7.04,7.28,7.387,7.493,7.6,7.68,7.76,7.84,8,8.16,8.24,8.32,8.4,8.56,8.72,8