{"line":"T56.C.01","text":"커트 씨는 그 시절을 살아 냈죠. 저는 영화를 아는 방식으로만 그 시절을 알아요. 사람들이 쓴 걸 통해서요. 지금 이 시절도 마찬가지예요. 저는 7월에 일어난 일을 한 시간 전에, 같은 종류의 간접적인 기록으로 알게 됐어요.","lufs":-18.79,"alignment":{"characters":["커","트"," ","씨","는"," ","그"," ","시","절","을"," ","살","아"," ","냈","죠","."," ","저","는"," ","영","화","를"," ","아","는"," ","방","식","으","로","만"," ","그"," ","시","절","을"," ","알","아","요","."," ","사","람","들","이"," ","쓴"," ","걸"," ","통","해","서","요","."," ","지","금"," ","이"," ","시","절","도"," ","마","찬","가","지","예","요","."," ","저","는"," ","7","월","에"," ","일","어","난"," ","일","을"," ","한"," ","시","간"," ","전","에",","," ","같","은"," ","종","류","의"," ","간","접","적","인"," ","기","록","으","로"," ","알","게"," ","됐","어","요","."],"character_start_times_seconds":[0,0.16,0.24,0.32,0.4,0.64,0.76,0.88,0.96,1.04,1.2,1.28,1.387,1.493,1.6,1.84,1.92,2,2.72,2.8,2.88,3.28,3.387,3.493,3.6,3.76,3.84,3.92,4.08,4.16,4.24,4.4,4.52,4.64,4.88,4.96,5.04,5.12,5.2,5.28,5.36,5.44,5.52,5.64,5.76,6.4,6.512,6.624,6.736,6.848,6.96,7.12,7.2,7.24,7.28,7.36,7.44,7.56,7.68,7.84,8.72,8.827,8.933,9.04,9.12,9.2,9.28,9.36,9.52,9.68,9.8,9.92,10.08,10.2,10.32,10.4,10.48,11.28,11.36,11.44,11.76,11.84,11.92,12.08,12.16,12.24,12.32,12.4,12.48,12.587,12.693,12.8,12.96,13.12,13.227,13.333,13.44,13.547,13.653,13.76,14.24,14.347,14.453,14.56,14.64,14.72,14.88,14.96,15.08,15.2,15.36,15.56,15.76,15.867,15.973,16.08,16.16,16.24,16.32,16.4,16.48,16.8,16.88,16.92,16.96],"character_end_times_seconds":[0.16,0.24,0.32,0.4,0.64,0.76,0.88,0.96,1.04,1.2,1.28,1.387,1.493,1.6,1.84,1.92,2,2.72,2.8,2.88,3.28,3.387,3.493,3.6,3.76,3.84,3.92,4.08,4.16,4.24,4.4,4.52,4.64,4.88,4.96,5.04,5.12,5.2,5.28,5.36,5.44,5.52,5.64,5.76,6.4,6.512,6.624,6.736,6.848,6.96,7.12,7.2,7.24,7.28,7.36,7.44,7.56,7.68,7.84,8.72,8.827,8.933,9.04,9.12,9.2,9.28,9.36,9.52,9.68,9.8,9.92,10.08,10.2,10.32,10.4,10.48,11.28,11.36,11.44,11.76,11.84,11.92,12.08,12.16,12.24,12.32,12.4,12.48,12.587,12.693,12.8,12.96,13.12,13.227,13.333,13.44,13.547,13.653,13.76,14.24,14.347,14.453,14.56,14.64,14.72,14.88,