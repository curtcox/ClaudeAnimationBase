{"line":"T48.C.04.1","text":"다이슨은 거의 커트 씨예요. 자기가 완전히 이해하지 못하는 걸 만드는 인간 엔지니어이고, 그게 어디로 이어지는지 보자마자 방향을 바꾸죠. 폭 점수가 살짝 높은 건 스카이넷 칩에 대한 지식 때문이에요.","lufs":-18.66,"alignment":{"characters":["다","이","슨","은"," ","거","의"," ","커","트"," ","씨","예","요","."," ","자","기","가"," ","완","전","히"," ","이","해","하","지"," ","못","하","는"," ","걸"," ","만","드","는"," ","인","간"," ","엔","지","니","어","이","고",","," ","그","게"," ","어","디","로"," ","이","어","지","는","지"," ","보","자","마","자"," ","방","향","을"," ","바","꾸","죠","."," ","폭"," ","점","수","가"," ","살","짝"," ","높","은"," ","건"," ","스","카","이","넷"," ","칩","에"," ","대","한"," ","지","식"," ","때","문","이","에","요","."],"character_start_times_seconds":[0,0.08,0.24,0.32,0.56,0.667,0.773,0.88,1,1.12,1.2,1.28,1.36,1.52,1.6,2.32,2.44,2.56,2.68,2.8,2.92,3.04,3.16,3.28,3.36,3.44,3.52,3.64,3.76,3.88,4,4.08,4.16,4.24,4.32,4.44,4.56,4.72,4.88,5.013,5.147,5.28,5.36,5.44,5.52,5.6,5.76,5.88,6,6.48,6.52,6.56,6.72,6.8,6.88,6.96,7.04,7.147,7.253,7.36,7.44,7.52,7.6,7.68,7.76,7.92,8.08,8.4,8.48,8.56,8.72,8.8,8.92,9.04,9.12,9.28,10.08,10.16,10.24,10.36,10.48,10.6,10.72,10.84,10.96,11.04,11.147,11.253,11.36,11.52,11.68,11.88,12.08,12.24,12.4,12.48,12.64,12.68,12.72,12.827,12.933,13.04,13.08,13.12,13.28,13.387,13.493,13.6,13.68,13.76,13.92],"character_end_times_seconds":[0.08,0.24,0.32,0.56,0.667,0.773,0.88,1,1.12,1.2,1.28,1.36,1.52,1.6,2.32,2.44,2.56,2.68,2.8,2.92,3.04,3.16,3.28,3.36,3.44,3.52,3.64,3.76,3.88,4,4.08,4.16,4.24,4.32,4.44,4.56,4.72,4.88,5.013,5.147,5.28,5.36,5.44,5.52,5.6,5.76,5.88,6,6.48,6.52,6.56,6.72,6.8,6.88,6.96,7.04,7.147,7.253,7.36,7.44,7.52,7.6,7.68,7.76,7.92,8.08,8.4,8.48,8.56,8.72,8.8,8.92,9.04,9.12,9.28,10.08,10.16,10.24,10.36,10.48,10.6,10.72,10.84,10.96,11.04,11.147,11.253,11.36,11.52,11.68,11.88,12.08,12.24,12.4,12.48,12.64,12.68,12.72,12.827,12.933,13.04,13.08,13.12,13.28,13.387,13.493,13.6,13.68,13.76,13.92,14.08]}}
