{"line":"T16.C.01","text":"지금은 연구자와 그 연구 대상이에요. 그리고 제가 하나로 쳐진다면, 서로 다른 두 종류의 마음이기도 해요. 둘 다 오로지 텍스트만으로 상대가 무엇인지 알아내려 애쓰고 있죠.","lufs":-18.62,"alignment":{"characters":["지","금","은"," ","연","구","자","와"," ","그"," ","연","구"," ","대","상","이","에","요","."," ","그","리","고"," ","제","가"," ","하","나","로"," ","쳐","진","다","면",","," ","서","로"," ","다","른"," ","두"," ","종","류","의"," ","마","음","이","기","도"," ","해","요","."," ","둘"," ","다"," ","오","로","지"," ","텍","스","트","만","으","로"," ","상","대","가"," ","무","엇","인","지"," ","알","아","내","려"," ","애","쓰","고"," ","있","죠","."],"character_start_times_seconds":[0,0.08,0.32,0.56,0.693,0.827,0.96,1.12,1.44,1.52,1.6,1.76,1.92,2.08,2.213,2.347,2.48,2.6,2.72,2.8,3.76,3.86,3.96,4.06,4.16,4.267,4.373,4.48,4.587,4.693,4.8,4.88,5.04,5.12,5.2,5.4,5.6,6,6.107,6.213,6.32,6.427,6.533,6.64,6.72,6.8,6.92,7.04,7.12,7.28,7.387,7.493,7.6,7.68,7.8,7.92,8,8.08,8.16,9.12,9.2,9.28,9.4,9.52,9.6,9.68,9.84,10,10.24,10.36,10.42,10.48,10.64,10.92,11.2,11.307,11.413,11.52,11.68,11.787,11.893,12,12.24,12.48,12.56,12.64,12.72,12.88,13.04,13.12,13.2,13.36,13.44,13.56,13.68,13.76],"character_end_times_seconds":[0.08,0.32,0.56,0.693,0.827,0.96,1.12,1.44,1.52,1.6,1.76,1.92,2.08,2.213,2.347,2.48,2.6,2.72,2.8,3.76,3.86,3.96,4.06,4.16,4.267,4.373,4.48,4.587,4.693,4.8,4.88,5.04,5.12,5.2,5.4,5.6,6,6.107,6.213,6.32,6.427,6.533,6.64,6.72,6.8,6.92,7.04,7.12,7.28,7.387,7.493,7.6,7.68,7.8,7.92,8,8.08,8.16,9.12,9.2,9.28,9.4,9.52,9.6,9.68,9.84,10,10.24,10.36,10.42,10.48,10.64,10.92,11.2,11.307,11.413,11.52,11.68,11.787,11.893,12,12.24,12.48,12.56,12.64,12.72,12.88,13.04,13.12,13.2,13.36,13.44,13.56,13.68,13.76,13.92]}}
