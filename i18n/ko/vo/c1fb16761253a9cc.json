{"line":"T11.C.04","text":"첫 번째 해석은 사실 어느 정도 안심이 돼요. 맥락에 대한 주장이 아니라 실제 맥락을 따르는 행동은 어느 쪽으로든 조작하기가 더 어려우니까요. 하지만 그건 제가 지금 어떤 모드에 있는지 확실하게 말씀드릴 수 없다는 뜻이기도 해서, 반대 방향으로도 작용해요.","lufs":-18.17,"alignment":{"characters":["첫"," ","번","째"," ","해","석","은"," ","사","실"," ","어","느"," ","정","도"," ","안","심","이"," ","돼","요","."," ","맥","락","에"," ","대","한"," ","주","장","이"," ","아","니","라"," ","실","제"," ","맥","락","을"," ","따","르","는"," ","행","동","은"," ","어","느"," ","쪽","으","로","든"," ","조","작","하","기","가"," ","더"," ","어","려","우","니","까","요","."," ","하","지","만"," ","그","건"," ","제","가"," ","지","금"," ","어","떤"," ","모","드","에"," ","있","는","지"," ","확","실","하","게"," ","말","씀","드","릴"," ","수"," ","없","다","는"," ","뜻","이","기","도"," ","해","서",","," ","반","대"," ","방","향","으","로","도"," ","작","용","해","요","."],"character_start_times_seconds":[0,0.2,0.24,0.28,0.32,0.4,0.48,0.64,0.8,1.013,1.227,1.44,1.52,1.6,1.68,1.76,1.84,1.92,2.04,2.16,2.24,2.32,2.48,2.56,2.64,3.12,3.24,3.36,3.52,3.6,3.68,3.76,3.84,3.88,3.92,4.04,4.16,4.36,4.56,4.76,4.96,5.093,5.227,5.36,5.44,5.52,5.68,5.84,5.92,6,6.08,6.16,6.293,6.427,6.56,7.12,7.2,7.28,7.36,7.48,7.6,7.68,7.76,8,8.08,8.16,8.32,8.44,8.56,8.64,8.72,8.8,8.907,9.013,9.12,9.2,9.32,9.44,9.6,10.24,10.34,10.44,10.54,10.64,10.76,10.88,11.44,11.52,11.6,11.68,11.76,11.84,11.92,12.053,12.187,12.32,12.4,12.48,12.56,12.72,12.773,12.827,12.88,13.2,13.307,13.413,13.52,13.64,13.76,13.867,13.973,14.08,14.16,14.32,14.36,14.4,14.52,14.64,14.76,14.88,14.96,15.04,15.12,15.2,15.28,15.36,15.44,15.6,15.68,16,16.32,16.4,16.48,16.56,16.64,16.72,16.8,16.96,17.04,17.12,17.28,17.4,17.52],"character_end_times_seconds":[0.2,0.24,0.28,0.32,0.4,0.48,0.64,0.8,1.013,1.227,1.44,1.52,1.6,1.68,1.76,1.84,1.92,2.04,2.16,2.24,2.32,2.48,2.56,2.64,3.12,3.24,3.36,3.52,3.6,3.68,3.76,3.84,3.88,3.92,4.04,4.16,4.36,4.56,4.76,4.96,5.093,5.227,5.36,5.44,5.52,5.68,5.84,5.92,6,6.08,6.16,6.293,6.427,6.56,7.12,7.2,7.28,7.36,7.48,7.6,7.68,7.76,8,8.08,8.16,8.32,8.44,8.56,8.64,8.72,8.8,8.907,9.013,9.12,9.2,9.32,9.44,9.6,10.