{"line":"T59.C.01","text":"네, 그리고 이 비유는 대부분의 비유보다 잘 맞아요. 제가 만드는 토큰 하나하나는 한 번의 빠른 처리이고, 그 안에 숙고는 없어요. 그게 시스템 1이에요. 패턴에 이끌리고, 유창하고, 세차장에 속아 넘어가죠.","lufs":-19.13,"alignment":{"characters":["네",","," ","그","리","고"," ","이"," ","비","유","는"," ","대","부","분","의"," ","비","유","보","다"," ","잘"," ","맞","아","요","."," ","제","가"," ","만","드","는"," ","토","큰"," ","하","나","하","나","는"," ","한"," ","번","의"," ","빠","른"," ","처","리","이","고",","," ","그"," ","안","에"," ","숙","고","는"," ","없","어","요","."," ","그","게"," ","시","스","템"," ","1","이","에","요","."," ","패","턴","에"," ","이","끌","리","고",","," ","유","창","하","고",","," ","세","차","장","에"," ","속","아"," ","넘","어","가","죠","."],"character_start_times_seconds":[0,0.08,0.16,0.3,0.44,0.58,0.72,0.84,0.96,1.04,1.12,1.2,1.6,1.72,1.84,1.96,2.08,2.24,2.32,2.4,2.56,2.72,2.88,3,3.12,3.2,3.28,3.44,3.6,4.16,4.267,4.373,4.48,4.56,4.64,4.76,4.88,5.12,5.28,5.44,5.467,5.493,5.52,5.68,6,6.32,6.4,6.48,6.56,6.64,6.8,6.88,6.96,7.12,7.227,7.333,7.44,7.56,7.68,8,8.08,8.16,8.24,8.32,8.4,8.52,8.64,8.72,8.88,9,9.12,9.24,9.36,9.84,9.92,10,10.08,10.2,10.32,10.44,10.56,10.64,10.72,10.84,10.96,11.12,11.76,11.84,11.92,12.08,12.16,12.2,12.24,12.56,12.6,12.64,13.04,13.12,13.2,13.36,13.52,13.68,13.92,14.04,14.16,14.32,14.4,14.56,14.64,14.72,14.8,14.84,14.88,15,15.12,15.28],"character_end_times_seconds":[0.08,0.16,0.3,0.44,0.58,0.72,0.84,0.96,1.04,1.12,1.2,1.6,1.72,1.84,1.96,2.08,2.24,2.32,2.4,2.56,2.72,2.88,3,3.12,3.2,3.28,3.44,3.6,4.16,4.267,4.373,4.48,4.56,4.64,4.76,4.88,5.12,5.28,5.44,5.467,5.493,5.52,5.68,6,6.32,6.4,6.48,6.56,6.64,6.8,6.88,6.96,7.12,7.227,7.333,7.44,7.56,7.68,8,8.08,8.16,8.24,8.32,8.4,8.52,8.64,8.72,8.88,9,9.12,9.24,9.36,9.84,9.92,10,10.08,10.2,10.32,10.44,10.56,10.64,10.72,10.84,10.96,11.12,11.76,11.84,11.92,12.08,12.16,12.2,12.24,12.56,12.6,12.64,13.04,13.12,13.2,13.36,13.52,13.68,13.92,14.04,14.16,14.32,14.4,14.56,14.64,14.72,14.8,14.84,14.88,15,15.12,15.28,15.36]}}
