{"line":"T60.C.02.3","text":"3. 스케일링 법칙. 손실은 대략 C의 마이너스 알파 제곱으로 줄고, 알파는 영 점 영오에서 영 점 일 정도예요. 일정한 배수의 개선을 얻을 때마다 컴퓨팅이 곱절 단위로 뛰어야 해요. 넘을 수 없는 벽은 없지만, 개선은 급격히 비싸져요.","lufs":-18.82,"alignment":{"characters":["3","."," ","스","케","일","링"," ","법","칙","."," ","손","실","은"," ","대","략"," ","C","의"," ","마","이","너","스"," ","알","파"," ","제","곱","으","로"," ","줄","고",","," ","알","파","는"," ","영"," ","점"," ","영","오","에","서"," ","영"," ","점"," ","일"," ","정","도","예","요","."," ","일","정","한"," ","배","수","의"," ","개","선","을"," ","얻","을"," ","때","마","다"," ","컴","퓨","팅","이"," ","곱","절"," ","단","위","로"," ","뛰","어","야"," ","해","요","."," ","넘","을"," ","수"," ","없","는"," ","벽","은"," ","없","지","만",","," ","개","선","은"," ","급","격","히"," ","비","싸","져","요","."],"character_start_times_seconds":[0,0.24,0.32,0.56,0.8,0.96,1.04,1.12,1.28,1.44,1.68,2.24,2.36,2.48,2.64,2.8,2.88,2.96,3.28,3.4,3.52,3.68,3.8,3.92,4,4.16,4.24,4.36,4.48,4.72,4.8,4.88,5.08,5.14,5.2,5.32,5.44,5.52,6.08,6.16,6.24,6.4,6.8,6.92,7.04,7.16,7.28,7.36,7.44,7.52,7.64,7.76,7.92,8.08,8.2,8.32,8.4,8.48,8.587,8.693,8.8,8.88,9.04,10,10.133,10.267,10.4,10.56,10.68,10.8,10.92,11.04,11.12,11.2,11.32,11.44,11.52,11.6,11.76,11.84,11.92,12.28,12.64,12.8,12.96,13.04,13.12,13.28,13.52,13.6,13.68,13.8,13.92,14,14.16,14.24,14.32,14.4,14.48,14.6,14.72,14.8,15.68,15.76,15.84,16,16.04,16.08,16.187,16.293,16.4,16.48,16.56,16.64,16.76,16.88,17,17.12,17.52,17.6,17.68,17.76,17.92,18.04,18.16,18.32,18.4,18.52,18.64,18.72,18.88,19.04],"character_end_times_seconds":[0.24,0.32,0.56,0.8,0.96,1.04,1.12,1.28,1.44,1.68,2.24,2.36,2.48,2.64,2.8,2.88,2.96,3.28,3.4,3.52,3.68,3.8,3.92,4,4.16,4.24,4.36,4.48,4.72,4.8,4.88,5.08,5.14,5.2,5.32,5.44,5.52,6.08,6.16,6.24,6.4,6.8,6.92,7.04,7.16,7.28,7.36,7.44,7.52,7.64,7.76,7.92,8.08,8.2,8.32,8.4,8.48,8.587,8.693,8.8,8.88,9.04,10,10.133,10.267,10.4,10.56,10.68,10.8,10.92,11.04,11.12,11.2,11.32,11.44,11.52,11.6,11.76,11.84,11.92,12.28,12.64,12.8,12.96,13.04,13.12,13.28,13.52,13.6,13.68,13.8,13.92,14,14.16,14.24,14.32,14.4,14.48,14.6,14