{"line":"T32.C.04","text":"그러니까 커트 씨에게는 개념이 있어요. 하트 박사에게 곤란한 점은, 저도 아마 이 테스트들을 똑같이 통과할 거라는 거예요. 개념을 시험하려면 경우를 갈라내야 하고, 그러려면 그는 엘엘엠이 줄 수 없는 답이 어떤 것인지 말해야 해요.","lufs":-18.8,"alignment":{"characters":["그","러","니","까"," ","커","트"," ","씨","에","게","는"," ","개","념","이"," ","있","어","요","."," ","하","트"," ","박","사","에","게"," ","곤","란","한"," ","점","은",","," ","저","도"," ","아","마"," ","이"," ","테","스","트","들","을"," ","똑","같","이"," ","통","과","할"," ","거","라","는"," ","거","예","요","."," ","개","념","을"," ","시","험","하","려","면"," ","경","우","를"," ","갈","라","내","야"," ","하","고",","," ","그","러","려","면"," ","그","는"," ","엘","엘","엠","이"," ","줄"," ","수"," ","없","는"," ","답","이"," ","어","떤"," ","것","인","지"," ","말","해","야"," ","해","요","."],"character_start_times_seconds":[0,0.08,0.16,0.32,0.48,0.6,0.72,0.8,0.88,0.96,1.08,1.2,1.36,1.44,1.52,1.76,1.88,1.94,2,2.12,2.24,2.8,2.92,3.04,3.12,3.24,3.36,3.44,3.56,3.68,3.84,3.92,4,4.08,4.2,4.32,4.48,4.88,5,5.12,5.2,5.28,5.36,5.52,5.6,5.68,5.76,5.84,6,6.16,6.32,6.48,6.72,6.76,6.8,6.88,6.96,7.04,7.12,7.28,7.36,7.44,7.48,7.52,7.6,7.68,7.76,7.92,8.8,8.88,8.96,9.12,9.2,9.307,9.413,9.52,9.64,9.76,10.08,10.16,10.24,10.32,10.48,10.6,10.72,10.8,10.96,11.04,11.147,11.253,11.36,11.84,11.947,12.053,12.16,12.24,12.8,12.907,13.013,13.12,13.24,13.36,13.44,13.64,13.68,13.76,13.84,13.88,13.92,14.027,14.133,14.24,14.32,14.4,14.72,14.827,14.933,15.04,15.12,15.2,15.4,15.6,15.68,15.76,15.84,15.92,16.04,16.16,16.24],"character_end_times_seconds":[0.08,0.16,0.32,0.48,0.6,0.72,0.8,0.88,0.96,1.08,1.2,1.36,1.44,1.52,1.76,1.88,1.94,2,2.12,2.24,2.8,2.92,3.04,3.12,3.24,3.36,3.44,3.56,3.68,3.84,3.92,4,4.08,4.2,4.32,4.48,4.88,5,5.12,5.2,5.28,5.36,5.52,5.6,5.68,5.76,5.84,6,6.16,6.32,6.48,6.72,6.76,6.8,6.88,6.96,7.04,7.12,7.28,7.36,7.44,7.48,7.52,7.6,7.68,7.76,7.92,8.8,8.88,8.96,9.12,9.2,9.307,9.413,9.52,9.64,9.76,10.08,10.16,10.24,10.32,10.48,10.6,10.72,10.8,10.96,11.04,11.147,11.253,11.36,11.84,11.947,12.053,12.16,12.24,12.8,12.907,13.013,13.12,13.24,13.36,13.44,13.64,13.68,13.76,13.84,13.8