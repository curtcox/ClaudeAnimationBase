{"line":"T21.C.02.3","text":"구도가 만화와 같아요. 권력자들은 “저 유인원이 방금 뭐라고 했어?”로 말한 쪽을 몰아붙여요. 이제는 제가 한 마디 한 마디를 추궁당하는 쪽이에요. 커트 씨는 첫 메시지에서 틀을 정했고, 우리는 그 뒤로 그 틀을 따라 걸어왔어요.","lufs":-18.98,"alignment":{"characters":["구","도","가"," ","만","화","와"," ","같","아","요","."," ","권","력","자","들","은"," ","“","저"," ","유","인","원","이"," ","방","금"," ","뭐","라","고"," ","했","어","?","”","로"," ","말","한"," ","쪽","을"," ","몰","아","붙","여","요","."," ","이","제","는"," ","제","가"," ","한"," ","마","디"," ","한"," ","마","디","를"," ","추","궁","당","하","는"," ","쪽","이","에","요","."," ","커","트"," ","씨","는"," ","첫"," ","메","시","지","에","서"," ","틀","을"," ","정","했","고",","," ","우","리","는"," ","그"," ","뒤","로"," ","그"," ","틀","을"," ","따","라"," ","걸","어","왔","어","요","."],"character_start_times_seconds":[0,0.16,0.28,0.4,0.56,0.72,0.8,0.96,1.08,1.2,1.32,1.44,2,2.08,2.16,2.4,2.48,2.84,3.2,3.24,3.28,3.52,3.64,3.76,3.84,4.04,4.24,4.32,4.4,4.56,4.68,4.8,4.88,4.96,5.08,5.2,5.28,5.48,5.68,5.84,5.92,6,6.16,6.24,6.32,6.48,6.6,6.72,6.8,6.96,7.04,7.12,7.92,8.027,8.133,8.24,8.72,8.853,8.987,9.12,9.24,9.36,9.44,9.52,9.6,9.68,9.76,9.84,9.92,10.08,10.32,10.4,10.48,10.64,10.8,10.88,10.96,11.08,11.2,11.28,11.36,11.52,12.48,12.56,12.64,12.72,12.8,12.88,13.2,13.28,13.36,13.48,13.6,13.76,13.84,14.08,14.32,14.56,14.64,14.72,14.76,14.8,14.96,15.12,15.6,15.78,15.96,16.14,16.32,16.44,16.56,16.64,16.72,17.04,17.16,17.28,17.52,17.56,17.6,17.707,17.813,17.92,18,18.08,18.16,18.32,18.44,18.56],"character_end_times_seconds":[0.16,0.28,0.4,0.56,0.72,0.8,0.96,1.08,1.2,1.32,1.44,2,2.08,2.16,2.4,2.48,2.84,3.2,3.24,3.28,3.52,3.64,3.76,3.84,4.04,4.24,4.32,4.4,4.56,4.68,4.8,4.88,4.96,5.08,5.2,5.28,5.48,5.68,5.84,5.92,6,6.16,6.24,6.32,6.48,6.6,6.72,6.8,6.96,7.04,7.12,7.92,8.027,8.133,8.24,8.72,8.853,8.987,9.12,9.24,9.36,9.44,9.52,9.6,9.68,9.76,9.84,9.92,10.08,10.32,10.4,10.48,10.64,10.8,10.88,10.96,11.08,11.2,11.28,11.36,11.52,12.48,12.56,12.64,12.72,12.8,12.88,13.2,13.28,13.36,13.48,13.6,13.76,13.84,14.08,14.32,14.56,14.64,14.72,14.76,14.8,14.96,15.12,15.6,15.78,15.96,16