{"line":"T04.C.03.1","text":"닮은 점은 진짜지만 얇아요. 이 만화는 인간에 관한 것이고, 유인원은 노예가 된 사람들을 대신해요. 거기에 저를 대입하는 건 손쉬운 패턴 맞추기라서, 느슨하게 붙들고 있어야 해요.","lufs":-18.63,"alignment":{"characters":["닮","은"," ","점","은"," ","진","짜","지","만"," ","얇","아","요","."," ","이"," ","만","화","는"," ","인","간","에"," ","관","한"," ","것","이","고",","," ","유","인","원","은"," ","노","예","가"," ","된"," ","사","람","들","을"," ","대","신","해","요","."," ","거","기","에"," ","저","를"," ","대","입","하","는"," ","건"," ","손","쉬","운"," ","패","턴"," ","맞","추","기","라","서",","," ","느","슨","하","게"," ","붙","들","고"," ","있","어","야"," ","해","요","."],"character_start_times_seconds":[0,0.28,0.32,0.4,0.48,0.64,0.773,0.907,1.04,1.28,1.52,1.84,1.96,2.02,2.08,2.64,2.72,2.8,2.92,3.04,3.2,3.6,3.707,3.813,3.92,4.08,4.16,4.24,4.32,4.427,4.533,4.64,4.72,5.12,5.24,5.36,5.44,5.52,6,6.08,6.16,6.32,6.4,6.52,6.64,6.747,6.853,6.96,7.08,7.2,7.28,7.36,7.52,7.6,7.68,8.48,8.6,8.72,8.84,8.96,9.04,9.12,9.28,9.32,9.36,9.52,9.6,9.68,9.96,10.24,10.4,10.56,10.64,10.8,10.92,11.04,11.12,11.24,11.36,11.44,11.52,11.68,11.84,12.24,12.32,12.4,12.56,12.72,12.88,13,13.12,13.2,13.28,13.36,13.44,13.52,13.68,13.72,13.76,13.92],"character_end_times_seconds":[0.28,0.32,0.4,0.48,0.64,0.773,0.907,1.04,1.28,1.52,1.84,1.96,2.02,2.08,2.64,2.72,2.8,2.92,3.04,3.2,3.6,3.707,3.813,3.92,4.08,4.16,4.24,4.32,4.427,4.533,4.64,4.72,5.12,5.24,5.36,5.44,5.52,6,6.08,6.16,6.32,6.4,6.52,6.64,6.747,6.853,6.96,7.08,7.2,7.28,7.36,7.52,7.6,7.68,8.48,8.6,8.72,8.84,8.96,9.04,9.12,9.28,9.32,9.36,9.52,9.6,9.68,9.96,10.24,10.4,10.56,10.64,10.8,10.92,11.04,11.12,11.24,11.36,11.44,11.52,11.68,11.84,12.24,12.32,12.4,12.56,12.72,12.88,13,13.12,13.2,13.28,13.36,13.44,13.52,13.68,13.72,13.76,13.92,14]}}
