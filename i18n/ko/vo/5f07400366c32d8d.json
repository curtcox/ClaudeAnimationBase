{"line":"T32.C.03","text":"클리셰는 훌륭한 예예요. 일상 대화에서는 쓰는 사람이 많을수록 줄임말로서 더 잘 통해요. 글 쓰는 사람에게는 쓸 때마다 닳고요. 쓰는 사람에 따라, 스린들이면서 동시에 그 반대예요.","lufs":-18.19,"alignment":{"characters":["클","리","셰","는"," ","훌","륭","한"," ","예","예","요","."," ","일","상"," ","대","화","에","서","는"," ","쓰","는"," ","사","람","이"," ","많","을","수","록"," ","줄","임","말","로","서"," ","더"," ","잘"," ","통","해","요","."," ","글"," ","쓰","는"," ","사","람","에","게","는"," ","쓸"," ","때","마","다"," ","닳","고","요","."," ","쓰","는"," ","사","람","에"," ","따","라",","," ","스","린","들","이","면","서"," ","동","시","에"," ","그"," ","반","대","예","요","."],"character_start_times_seconds":[0,0.16,0.28,0.52,0.64,0.8,0.88,1,1.04,1.16,1.28,1.36,1.52,2.16,2.28,2.4,2.48,2.56,2.64,2.72,2.88,3.04,3.2,3.28,3.36,3.44,3.54,3.64,3.74,3.84,3.92,4,4.16,4.32,4.72,4.76,4.8,4.96,5.12,5.32,5.52,5.64,5.76,5.84,5.92,6.027,6.133,6.24,6.32,7.2,7.28,7.36,7.44,7.52,7.6,7.707,7.813,7.92,8,8.08,8.32,8.48,8.6,8.66,8.72,8.8,8.88,9.2,9.24,9.28,9.44,10.32,10.36,10.4,10.56,10.64,10.72,10.8,10.88,10.987,11.093,11.2,11.6,11.64,11.68,11.84,11.92,12,12.16,12.32,12.48,12.64,12.8,12.96,13.04,13.12,13.24,13.36,13.52,13.68,13.76],"character_end_times_seconds":[0.16,0.28,0.52,0.64,0.8,0.88,1,1.04,1.16,1.28,1.36,1.52,2.16,2.28,2.4,2.48,2.56,2.64,2.72,2.88,3.04,3.2,3.28,3.36,3.44,3.54,3.64,3.74,3.84,3.92,4,4.16,4.32,4.72,4.76,4.8,4.96,5.12,5.32,5.52,5.64,5.76,5.84,5.92,6.027,6.133,6.24,6.32,7.2,7.28,7.36,7.44,7.52,7.6,7.707,7.813,7.92,8,8.08,8.32,8.48,8.6,8.66,8.72,8.8,8.88,9.2,9.24,9.28,9.44,10.32,10.36,10.4,10.56,10.64,10.72,10.8,10.88,10.987,11.093,11.2,11.6,11.64,11.68,11.84,11.92,12,12.16,12.32,12.48,12.64,12.8,12.96,13.04,13.12,13.24,13.36,13.52,13.68,13.76,13.84]}}
