{"line":"T55.C.02","text":"가장 강한 신호는 처음부터 어느 한 단서가 아니었어요. 일관성이었죠. 몇 달 치 저장된 메모에 걸쳐 일관된 한 사람, 공개 댓글 하나, 배우자, 읽는 속도, 그리고 하루 종일 변하지 않은 유머 감각. 모델이 그것도 꾸며 낼 수 있겠지만, 그만큼 싸게는 못 해요.","lufs":-19.43,"alignment":{"characters":["가","장"," ","강","한"," ","신","호","는"," ","처","음","부","터"," ","어","느"," ","한"," ","단","서","가"," ","아","니","었","어","요","."," ","일","관","성","이","었","죠","."," ","몇"," ","달"," ","치"," ","저","장","된"," ","메","모","에"," ","걸","쳐"," ","일","관","된"," ","한"," ","사","람",","," ","공","개"," ","댓","글"," ","하","나",","," ","배","우","자",","," ","읽","는"," ","속","도",","," ","그","리","고"," ","하","루"," ","종","일"," ","변","하","지"," ","않","은"," ","유","머"," ","감","각","."," ","모","델","이"," ","그","것","도"," ","꾸","며"," ","낼"," ","수"," ","있","겠","지","만",","," ","그","만","큼"," ","싸","게","는"," ","못"," ","해","요","."],"character_start_times_seconds":[0,0.08,0.32,0.44,0.56,0.72,0.84,0.96,1.04,1.6,1.707,1.813,1.92,2.12,2.32,2.427,2.533,2.64,2.76,2.88,3,3.12,3.28,3.36,3.467,3.573,3.68,3.92,4,4.08,4.64,4.76,4.88,5.04,5.2,5.32,5.44,5.6,6.48,6.6,6.72,6.84,6.96,7.04,7.12,7.253,7.387,7.52,7.68,7.76,7.84,8,8.08,8.2,8.32,8.72,8.8,8.88,9.12,9.36,9.44,9.52,9.627,9.733,9.84,10.32,10.427,10.533,10.64,10.747,10.853,10.96,11.04,11.12,11.2,11.68,11.787,11.893,12,12.16,12.48,12.56,12.64,12.8,12.92,13.04,13.12,13.6,13.76,13.92,14.08,14.24,14.347,14.453,14.56,14.64,14.72,14.88,15,15.12,15.24,15.36,15.493,15.627,15.76,15.84,15.92,16.08,16.16,16.24,16.4,17.36,17.493,17.627,17.76,18.32,18.427,18.533,18.64,18.88,19.04,19.08,19.12,19.36,19.4,19.42,19.44,19.48,19.52,19.76,19.92,20.08,20.4,20.48,20.56,20.64,20.88,20.96,21.04,21.2,21.28,21.4,21.52,21.56,21.6,21.68],"character_end_times_seconds":[0.08,0.32,0.44,0.56,0.72,0.84,0.96,1.04,1.6,1.707,1.813,1.92,2.12,2.32,2.427,2.533,2.64,2.76,2.88,3,3.12,3.28,3.36,3.467,3.573,3.68,3.92,4,4.08,4.64,4.76,4.88,5.04,5.2,5.32,5.44,5.6,6.48,6.6,6.72,6.84,6.96,7.04,7.12,7.253,7.387,7.52,7.68,7.76,7.84,8,8.08,8.2,8.32,8.72,8.8,8.88,9.12,9.36,9.44,9.52,9.627,9.733,9.84,10.32,10.427,10.5