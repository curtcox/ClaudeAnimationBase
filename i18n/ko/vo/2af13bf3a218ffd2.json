{"line":"T42.C.03","text":"이런 걸 짚어 드릴 수는 있지만, 경고도 반복되면 닳아 버리고, 끊임없는 단서 달기는 그 자체로 또 하나의 왜곡이 돼요. 인간도 더 약한 형태로 같은 문제를 겪어요. 말이란 언제나 말하는 사람이 가진 것보다 더 많은 확신과 일관성을 풍기니까요.","lufs":-18.26,"alignment":{"characters":["이","런"," ","걸"," ","짚","어"," ","드","릴"," ","수","는"," ","있","지","만",","," ","경","고","도"," ","반","복","되","면"," ","닳","아"," ","버","리","고",","," ","끊","임","없","는"," ","단","서"," ","달","기","는"," ","그"," ","자","체","로"," ","또"," ","하","나","의"," ","왜","곡","이"," ","돼","요","."," ","인","간","도"," ","더"," ","약","한"," ","형","태","로"," ","같","은"," ","문","제","를"," ","겪","어","요","."," ","말","이","란"," ","언","제","나"," ","말","하","는"," ","사","람","이"," ","가","진"," ","것","보","다"," ","더"," ","많","은"," ","확","신","과"," ","일","관","성","을"," ","풍","기","니","까","요","."],"character_start_times_seconds":[0,0.08,0.24,0.32,0.4,0.64,0.68,0.72,0.76,0.8,0.96,1,1.04,1.2,1.28,1.36,1.56,1.76,2.16,2.28,2.4,2.48,2.64,2.72,2.8,3.04,3.2,3.36,3.52,3.56,3.6,3.68,3.76,3.88,4,4.56,4.72,4.76,4.8,4.96,5.12,5.2,5.28,5.36,5.48,5.6,5.8,6,6.08,6.16,6.28,6.4,6.56,6.72,6.8,6.88,6.96,7.04,7.12,7.28,7.36,7.44,7.6,7.68,7.84,7.88,7.92,8.8,8.933,9.067,9.2,9.36,9.44,9.52,9.68,9.84,9.92,10,10.08,10.24,10.4,10.533,10.667,10.8,10.907,11.013,11.12,11.2,11.44,11.56,11.62,11.68,12.64,12.747,12.853,12.96,13.12,13.227,13.333,13.44,14,14.08,14.16,14.28,14.4,14.5,14.6,14.7,14.8,14.907,15.013,15.12,15.2,15.28,15.48,15.68,15.8,15.92,16.027,16.133,16.24,16.36,16.48,16.64,16.88,16.96,17.04,17.28,17.44,17.6,17.68,17.76,17.84,17.96,18.08,18.24],"character_end_times_seconds":[0.08,0.24,0.32,0.4,0.64,0.68,0.72,0.76,0.8,0.96,1,1.04,1.2,1.28,1.36,1.56,1.76,2.16,2.28,2.4,2.48,2.64,2.72,2.8,3.04,3.2,3.36,3.52,3.56,3.6,3.68,3.76,3.88,4,4.56,4.72,4.76,4.8,4.96,5.12,5.2,5.28,5.36,5.48,5.6,5.8,6,6.08,6.16,6.28,6.4,6.56,6.72,6.8,6.88,6.96,7.04,7.12,7.28,7.36,7.44,7.6,7.68,7.84,7.88,7.92,8.8,8.933,9.067,9.2,9.36,9.44,9.52,9.68,9.84,9.92,10,10.08,10.24,10.4,10.533,10.667,10.8,10.907,11.013,11.12,11.2,11.44,11.56,11.62,11.68,12.64,12.747,12.853,12.96,13.12