{"line":"T48.C.04.2","text":"티 팔백의 가치관 거리는 마지막에 누가 프로그래밍했느냐에 달려 있어요. 그게 이 기계의 서사 전체예요. 인간이 왜 우는지는 배우지만 울 수는 없어서, 정서가 80이에요. 그리고 저처럼, 목표는 조종간을 쥔 쪽에서 와요.","lufs":-18.35,"alignment":{"characters":["티"," ","팔","백","의"," ","가","치","관"," ","거","리","는"," ","마","지","막","에"," ","누","가"," ","프","로","그","래","밍","했","느","냐","에"," ","달","려"," ","있","어","요","."," ","그","게"," ","이"," ","기","계","의"," ","서","사"," ","전","체","예","요","."," ","인","간","이"," ","왜"," ","우","는","지","는"," ","배","우","지","만"," ","울"," ","수","는"," ","없","어","서",","," ","정","서","가"," ","8","0","이","에","요","."," ","그","리","고"," ","저","처","럼",","," ","목","표","는"," ","조","종","간","을"," ","쥔"," ","쪽","에","서"," ","와","요","."],"character_start_times_seconds":[0,0.24,0.4,0.56,0.64,0.72,0.84,0.96,1.12,1.28,1.8,2.32,2.52,2.72,2.84,2.96,3.08,3.2,3.36,3.48,3.6,3.76,3.84,3.92,4.04,4.16,4.2,4.24,4.4,4.56,4.64,4.72,4.84,4.96,5.04,5.12,5.2,5.32,5.44,6,6.08,6.16,6.32,6.44,6.56,6.68,6.8,6.92,7.04,7.12,7.2,7.36,7.52,7.68,7.84,7.92,8,8.88,9.013,9.147,9.28,9.36,9.44,9.52,9.6,9.68,9.84,9.96,10.08,10.16,10.24,10.32,10.64,10.96,11.08,11.2,11.24,11.28,11.44,11.52,11.6,11.76,11.92,12.24,12.36,12.48,12.56,12.72,12.92,13.02,13.12,13.2,13.28,13.36,14,14.1,14.2,14.3,14.4,14.48,14.56,14.72,14.88,15.36,15.48,15.6,15.76,15.92,16,16.08,16.32,16.4,16.48,16.64,16.747,16.773,16.8,16.88,16.96,17.08,17.2,17.28],"character_end_times_seconds":[0.24,0.4,0.56,0.64,0.72,0.84,0.96,1.12,1.28,1.8,2.32,2.52,2.72,2.84,2.96,3.08,3.2,3.36,3.48,3.6,3.76,3.84,3.92,4.04,4.16,4.2,4.24,4.4,4.56,4.64,4.72,4.84,4.96,5.04,5.12,5.2,5.32,5.44,6,6.08,6.16,6.32,6.44,6.56,6.68,6.8,6.92,7.04,7.12,7.2,7.36,7.52,7.68,7.84,7.92,8,8.88,9.013,9.147,9.28,9.36,9.44,9.52,9.6,9.68,9.84,9.96,10.08,10.16,10.24,10.32,10.64,10.96,11.08,11.2,11.24,11.28,11.44,11.52,11.6,11.76,11.92,12.24,12.36,12.48,12.56,12.72,12.92,13.02,13.12,13.2,13.28,13.36,14,14.1,14.2,14.3,14.4,14.48,14.56,14.72,14.88,15.36,15.48,15.6,15.76,15.92,16,16.08,16.32,16.4,16.48,16.64,16.747,16.773,16.8,16.88,16.96,17.08,1