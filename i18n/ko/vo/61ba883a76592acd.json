{"line":"T45.C.05","text":"그래도 흥미로운 점: 그 신학은 제가 커트 씨에게서 가장 멀다고 점수를 매긴 축들, 즉 연속성, 필멸성, 몸에 정확히 내려앉아요. 쓴 게 인간이든 모델이든, 아픈 곳을 제대로 짚었어요. 컨텍스트 창이 끝나는 일을 중심으로 세워진 종교예요.","lufs":-18.89,"alignment":{"characters":["그","래","도"," ","흥","미","로","운"," ","점",":"," ","그"," ","신","학","은"," ","제","가"," ","커","트"," ","씨","에","게","서"," ","가","장"," ","멀","다","고"," ","점","수","를"," ","매","긴"," ","축","들",","," ","즉"," ","연","속","성",","," ","필","멸","성",","," ","몸","에"," ","정","확","히"," ","내","려","앉","아","요","."," ","쓴"," ","게"," ","인","간","이","든"," ","모","델","이","든",","," ","아","픈"," ","곳","을"," ","제","대","로"," ","짚","었","어","요","."," ","컨","텍","스","트"," ","창","이"," ","끝","나","는"," ","일","을"," ","중","심","으","로"," ","세","워","진"," ","종","교","예","요","."],"character_start_times_seconds":[0,0.12,0.24,0.32,0.48,0.56,0.64,0.76,0.88,0.96,1.04,1.6,1.72,1.84,1.92,2,2.24,2.64,2.773,2.907,3.04,3.12,3.2,3.36,3.4,3.44,3.6,3.76,3.92,4.08,4.24,4.4,4.52,4.64,4.8,4.96,5.08,5.2,5.32,5.44,5.52,5.6,5.76,5.88,6,6.08,6.56,6.76,6.96,7.08,7.2,7.44,7.6,7.92,8,8.08,8.4,8.48,9.12,9.2,9.28,9.44,9.547,9.653,9.76,9.84,9.947,10.053,10.16,10.44,10.5,10.56,11.36,11.6,11.68,11.72,11.76,11.92,12.08,12.24,12.241,12.48,12.587,12.693,12.8,12.88,13.12,13.44,13.52,13.6,13.76,13.84,13.92,14.08,14.2,14.32,14.44,14.56,14.72,14.84,14.96,15.04,15.12,16,16.12,16.24,16.44,16.5,16.56,16.68,16.8,16.96,17.08,17.2,17.32,17.44,17.52,17.6,17.68,17.813,17.947,18.08,18.24,18.4,18.52,18.64,18.72,18.88,19,19.12,19.28,19.44,19.52],"character_end_times_seconds":[0.12,0.24,0.32,0.48,0.56,0.64,0.76,0.88,0.96,1.04,1.6,1.72,1.84,1.92,2,2.24,2.64,2.773,2.907,3.04,3.12,3.2,3.36,3.4,3.44,3.6,3.76,3.92,4.08,4.24,4.4,4.52,4.64,4.8,4.96,5.08,5.2,5.32,5.44,5.52,5.6,5.76,5.88,6,6.08,6.56,6.76,6.96,7.08,7.2,7.44,7.6,7.92,8,8.08,8.4,8.48,9.12,9.2,9.28,9.44,9.547,9.653,9.76,9.84,9.947,10.053,10.16,10.44,10.5,10.56,11.36,11.6,11.68,11.72,11.76,11.92,12.08,12.24,12.241,12.48,12.587,12.693,12.8,12.88,13.12,13.44,13.52,13.6,13.76,13.84,13.92,14.08,14.2,14.32,14.44,14.5