{
  "name": "claude-animation-base",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Clawd, painted in p5.brush: a character kit and guide for making hand-painted Clawd animations",
  "scripts": {
    "sheet": "node render.mjs --sheet=0,1,2,3,4,5 --out=out/sheet.jpg",
    "video": "node render.mjs --clip --out=out/video.mp4",
    "script": "node tools/build_script.mjs && node tools/verbatim_check.mjs",
    "refs": "node tools/check_refs.mjs",
    "qr": "node tools/qr_check.mjs",
    "qr:images": "node tools/qr_images.mjs",
    "reads": "node tools/read_check.mjs",
    "lint:chapter": "node tools/lint_chapter.mjs",
    "draft": "node render.mjs --draft",
    "site": "node tools/build_site.mjs",
    "serve": "node tools/serve.mjs",
    "watch": "node tools/watch.mjs",
    "review": "node tools/review.mjs",
    "rebuild": "node tools/rebuild.mjs"
  },
  "dependencies": {
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.11.0",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@undecaf/zbar-wasm": "^0.11.0",
    "@zxing/library": "^0.21.3",
    "jsqr": "^1.4.0",
    "marked": "^14.1.4",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  }
}
